def log(msg: str) -> None:
    print(msg, flush=True)


def sha256(text: str) -> str:
    return hashlib.sha256(text.encode()).hexdigest()


def get_conn() -> sqlite3.Connection:
    conn = sqlite3.connect(DB_PATH)
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA foreign_keys = ON")
    conn.row_factory = sqlite3.Row
    return conn


def get_source_snippet(file_path: str, line_num: int, context: int = 3) -> str:
    if line_num <= 0:
        return "[No valid line number]"
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            lines = f.readlines()
    except Exception as e:
        return f"[ERROR reading {file_path}: {e}]"
    if line_num < 1 or line_num > len(lines):
        return f"[ERROR: line {line_num} out of range]"
    start = max(0, line_num - context - 1)
    end = min(len(lines), line_num + context)
    snippet = []
    for i in range(start, end):
        prefix = ">" if i == line_num - 1 else " "
        snippet.append(f"{prefix}{i+1:4d}: {lines[i].rstrip()}")
    return "\n".join(snippet)


# =============================================================================
# DATABASE SCHEMA
# =============================================================================
def ensure_schema(conn: sqlite3.Connection) -> None:
    # WHAT: create all tables including known_repairs (new in v6.5.207)
    # WHY: known_repairs replaces hardcoded fix logic in fix_build_terrain_directly().
    #      Patterns are stored in the DB so new corruption instances discovered at
    #      runtime can be inserted as rows — permanent institutional memory.
    # Source (Tier 1): Gray & Reuter 1993 "Transaction Processing" Ch.1:
    #   "The database is the system of record. All state lives there."
    conn.executescript("""
        CREATE TABLE IF NOT EXISTS pipeline_runs (
            run_id INTEGER PRIMARY KEY AUTOINCREMENT,
            start_time TEXT, end_time TEXT, outcome TEXT,
            step_reached TEXT, version TEXT, hostname TEXT
        );
        CREATE TABLE IF NOT EXISTS applied_fixes (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            fix_id TEXT NOT NULL UNIQUE, file_path TEXT NOT NULL,
            fix_name TEXT NOT NULL, before_sha256 TEXT NOT NULL,
            after_sha256 TEXT NOT NULL, applied_at DATETIME DEFAULT CURRENT_TIMESTAMP,
            run_id INTEGER, status TEXT DEFAULT 'applied', error_pattern TEXT
        );
        CREATE TABLE IF NOT EXISTS auto_heal_actions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            run_id INTEGER, error_pattern TEXT, file_path TEXT,
            line_number INTEGER, patch_applied TEXT, status TEXT,
            created_ts DATETIME DEFAULT CURRENT_TIMESTAMP
        );
        CREATE TABLE IF NOT EXISTS source_mutations (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            file_path TEXT NOT NULL, mutation_name TEXT NOT NULL,
            before_sha256 TEXT NOT NULL, after_sha256 TEXT NOT NULL,
            success INTEGER NOT NULL, created_ts DATETIME DEFAULT CURRENT_TIMESTAMP
        );
        CREATE TABLE IF NOT EXISTS parse_checks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            file_path TEXT NOT NULL, parser TEXT NOT NULL,
            return_code INTEGER NOT NULL, output TEXT,
            created_ts DATETIME DEFAULT CURRENT_TIMESTAMP
        );
        CREATE TABLE IF NOT EXISTS game_state_log (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            run_id INTEGER, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
            game_state INTEGER, altitude REAL, is_deployed BOOLEAN, error TEXT
        );
        CREATE TABLE IF NOT EXISTS known_repairs (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            repair_id TEXT NOT NULL UNIQUE,
            description TEXT NOT NULL,
            corrupted_prefix TEXT NOT NULL,
            corrupted_suffix TEXT NOT NULL,
            correct_line TEXT NOT NULL,
            applies_to_file TEXT,
            discovered_version TEXT,
            created_ts DATETIME DEFAULT CURRENT_TIMESTAMP
        );
    """)
    conn.commit()
    log("[DB-SCHEMA] All tables ensured.")


def fix_already_applied(conn: sqlite3.Connection, fix_id: str) -> bool:
    cur = conn.execute("SELECT 1 FROM applied_fixes WHERE fix_id = ? AND status = 'applied'", (fix_id,))
    return cur.fetchone() is not None


def record_applied_fix(conn: sqlite3.Connection, fix_id: str, file_path: str,
                       fix_name: str, before_sha: str, after_sha: str,
                       run_id: int, error_pattern: str = "") -> None:
    conn.execute(
        """INSERT OR REPLACE INTO applied_fixes
           (fix_id, file_path, fix_name, before_sha256, after_sha256, run_id, error_pattern, status)
           VALUES (?, ?, ?, ?, ?, ?, ?, 'applied')""",
        (fix_id, file_path, fix_name, before_sha, after_sha, run_id, error_pattern)
    )
    conn.commit()


def open_run(conn: sqlite3.Connection) -> int:
    cur = conn.execute(
        "INSERT INTO pipeline_runs (start_time, outcome, step_reached, version, hostname) "
        "VALUES (datetime('now'), 'running', 'init', ?, ?)",
        (VERSION, socket.gethostname())
    )
    conn.commit()
    run_id = cur.lastrowid
    row = conn.execute("SELECT run_id, outcome FROM pipeline_runs WHERE run_id = ?", (run_id,)).fetchone()
    assert row and row['outcome'] == 'running', f"R082-FAIL: run_id={run_id} not confirmed"
    log(f"[DB-RUN] run_id={run_id} opened")
    return run_id


def close_run(conn: sqlite3.Connection, run_id: int, outcome: str, step: str) -> None:
    conn.execute(
        "UPDATE pipeline_runs SET end_time = datetime('now'), outcome = ?, step_reached = ? WHERE run_id = ?",
        (outcome, step, run_id)
    )
    conn.commit()
    row = conn.execute("SELECT outcome, end_time FROM pipeline_runs WHERE run_id = ?", (run_id,)).fetchone()
    assert row and row['outcome'] == outcome and row['end_time'] is not None, \
        f"R082-FAIL: close_run run_id={run_id}"
    log(f"[DB-RUN] run_id={run_id} closed outcome={outcome}")


def record_heal(conn: sqlite3.Connection, run_id: int, file_path: str, line: int,
                pattern: str, patch: str, status: str, snippet: str = "") -> None:
    if line > 0 and not snippet:
        snippet = get_source_snippet(file_path, line)
    if snippet:
        log(f"[VERBATIM] Code around line {line}:\n{snippet}")
        patch = f"{patch}\n\n[VERBATIM SNIPPET]\n{snippet}"
    conn.execute(
        "INSERT INTO auto_heal_actions (run_id, error_pattern, file_path, line_number, patch_applied, status) "
        "VALUES (?, ?, ?, ?, ?, ?)",
        (run_id, pattern, file_path, line, patch, status)
    )
    conn.commit()


def record_mutation(conn: sqlite3.Connection, file_path: str, name: str,
                    before: str, after: str, success: int) -> None:
    conn.execute(
        "INSERT INTO source_mutations (file_path, mutation_name, before_sha256, after_sha256, success) "
        "VALUES (?, ?, ?, ?, ?)",
        (file_path, name, before, after, success)
    )
    conn.commit()


# =============================================================================
# KAIZEN REPAIR CATALOGUE — replaces fix_build_terrain_directly()
# =============================================================================
def kaizen_repair_catalogue(conn: sqlite3.Connection) -> None:
    # WHAT: seed known_repairs table with every corruption pattern confirmed from
    #       diagnostic output on 2026-06-25. Uses INSERT OR IGNORE so re-runs
    #       are idempotent — existing rows are never overwritten.
    #
    # WHY: fix_build_terrain_directly() in v6.5.206 used str.replace() which
    #      matched any prefix of the corrupted string and appended to it on every
    #      call, growing the line by 58 chars per iteration over 5 iterations x 3
    #      calls = 15 total corruptions per pipeline run. The root cause was that
    #      gdformat strips indentation from multi-line boolean expressions that span
    #      a function boundary when the original source had a dangling 'or name'
    #      continuation. The catalogue stores the stable prefix+suffix of each
    #      corrupted form so apply_known_repairs() can find it by column-0
    #      detection regardless of how many '== "mixamorig_LeftArm"' tokens were
    #      appended by prior runs.
    #
    # Source (Tier 1): Hunt & Thomas 1999 "The Pragmatic Programmer" Ch.3 p.37:
    #   "DRY — Don't Repeat Yourself. Every piece of knowledge must have a single,
    #    unambiguous, authoritative representation within a system."
    #   Storing repairs in DB is the single authoritative representation.
    #
    # Source (Tier 1): McConnell 2004 "Code Complete" 2nd ed. Ch.8 p.195:
    #   "Use assertions to document and verify preconditions and postconditions."
    #   The corrupted_prefix/suffix pair is the precondition; correct_line is the
    #   postcondition enforced by apply_known_repairs().

    repairs = [
        # --- build_terrain.gd: right-arm bone check ---
        # Confirmed: diagnostic 2026-06-25 07:14
        # Line 564 started 'if name == "mixamorig_RightArm"' at column 0
        # Body line 565: '\t\t\t\t_right_arm_idx = i' (4 tabs) → if needs 4 tabs
        (
            "repair_bt_rightarm_v6507",
            "build_terrain.gd: right-arm bone if-check stripped of indent by gdformat",
            'if name == "mixamorig_RightArm"',
            'mixamorig:RightArm":',
            '\t\t\t\tif name == "mixamorig_RightArm" or name == "mixamorig:RightArm":',
            "build_terrain.gd",
        ),
        # --- build_terrain.gd: UTILITY obstacle type check ---
        # Confirmed: diagnostic 2026-06-25 07:18
        # Line 694 started 'if otype.begins_with("UTILITY")' at column 0
        # Body line 695: '\t\t\tcyl.top_radius = 0.15' (3 tabs) → if needs 3 tabs
        (
            "repair_bt_otype_utility_v6507",
            "build_terrain.gd: otype UTILITY if-check stripped of indent by gdformat",
            'if otype.begins_with("UTILITY")',
            '"POLE":',
            '\t\t\tif otype.begins_with("UTILITY") or otype == "POLE":',
            "build_terrain.gd",
        ),
        # --- build_terrain.gd: OPENING_ANIM game state check ---
        # Confirmed: diagnostic 2026-06-25 07:19 line 1309
        # Body line 1310: '\t\treturn 0.3' (2 tabs) → if needs 1 tab
        (
            "repair_bt_opening_anim_v6507",
            "build_terrain.gd: OPENING_ANIM state check stripped of indent",
            'if _game_state == GameState.OPENING_ANIM:',
            'if _game_state == GameState.OPENING_ANIM:',
            '\tif _game_state == GameState.OPENING_ANIM:',
            "build_terrain.gd",
        ),
        # --- build_terrain.gd: DIAGNOSIS game state check ---
        # Confirmed: diagnostic 2026-06-25 07:19 line 1311
        # Body line 1312: '\t\treturn 0.0' (2 tabs) → if needs 1 tab
        (
            "repair_bt_diagnosis_v6507",
            "build_terrain.gd: DIAGNOSIS state check stripped of indent",
            'if _game_state != GameState.DIAGNOSIS:',
            'if _game_state != GameState.DIAGNOSIS:',
            '\tif _game_state != GameState.DIAGNOSIS:',
            "build_terrain.gd",
        ),
        # --- build_terrain.gd: KEY_R input check (elif) ---
        # Confirmed: diagnostic 2026-06-25 07:20 line 1605
        # Sibling: '\t\telif event.keycode == KEY_F:' → must be elif at 2 tabs
        (
            "repair_bt_key_r_v6507",
            "build_terrain.gd: KEY_R input check stripped of indent and elif keyword",
            'if event.keycode == KEY_R:',
            'if event.keycode == KEY_R:',
            '\t\telif event.keycode == KEY_R:',
            "build_terrain.gd",
        ),
        # --- build_terrain.gd: _reserve_done check ---
        # Confirmed: diagnostic 2026-06-25 07:20 line 1695
        # Body line 1696: '\t\tep_status = "RESERVE ✓"' (2 tabs) → if needs 1 tab
        (
            "repair_bt_reserve_done_v6507",
            "build_terrain.gd: _reserve_done check stripped of indent",
            'if _reserve_done:',
            'if _reserve_done:',
            '\tif _reserve_done:',
            "build_terrain.gd",
        ),
        # --- build_terrain.gd: _cutaway_done check ---
        # Confirmed: diagnostic 2026-06-25 07:20 line 1697
        # Body line 1698: '\t\tep_status = ...' (2 tabs) → if needs 1 tab
        (
            "repair_bt_cutaway_done_v6507",
            "build_terrain.gd: _cutaway_done check stripped of indent",
            'if _cutaway_done:',
            'if _cutaway_done:',
            '\tif _cutaway_done:',
            "build_terrain.gd",
        ),
        # --- build_terrain.gd: _flight_control_checked check ---
        # Confirmed: diagnostic 2026-06-25 07:20 line 1699
        # Body line 1700: '\t\tep_status = ...' (2 tabs) → if needs 1 tab
        (
            "repair_bt_fc_checked_v6507",
            "build_terrain.gd: _flight_control_checked check stripped of indent",
            'if _flight_control_checked:',
            'if _flight_control_checked:',
            '\tif _flight_control_checked:',
            "build_terrain.gd",
        ),
        # --- build_terrain.gd: altitude > 500.0 check ---
        # Confirmed: diagnostic 2026-06-25 07:20 line 1766
        # Body line 1767: '\t\tnew_state = PatternState.BASE' (2 tabs) → if needs 1 tab
        (
            "repair_bt_altitude_500_v6507",
            "build_terrain.gd: altitude > 500.0 check stripped of indent",
            'if altitude > 500.0:',
            'if altitude > 500.0:',
            '\tif altitude > 500.0:',
            "build_terrain.gd",
        ),
    ]

    for repair_id, description, prefix, suffix, correct_line, applies_to in repairs:
        conn.execute(
            """INSERT OR IGNORE INTO known_repairs
               (repair_id, description, corrupted_prefix, corrupted_suffix,
                correct_line, applies_to_file, discovered_version)
               VALUES (?, ?, ?, ?, ?, ?, ?)""",
            (repair_id, description, prefix, suffix, correct_line, applies_to, VERSION)
        )
    conn.commit()

    count = conn.execute("SELECT COUNT(*) FROM known_repairs").fetchone()[0]
    log(f"[KAIZEN] known_repairs table: {count} entries seeded/confirmed.")


# =============================================================================
# APPLY KNOWN REPAIRS — idempotent, index-based, R082-verified
# =============================================================================

def rollback_repair(script_path: Path, repair_id: str) -> bool:
    """Rollback a repair if it corrupted the file"""
    backup_path = script_path.with_suffix(".backup_before_repair")
    if backup_path.exists():
        log(f"[ROLLBACK] Reverting {script_path} from {backup_path}")
        shutil.copy2(backup_path, script_path)
        backup_path.unlink()
        return True
    log(f"[ROLLBACK] No backup found for {repair_id}")
    return False


def apply_known_repairs(script_path: Path, conn: sqlite3.Connection, run_id: int) -> bool:
    # WHAT: scan script_path for any line that matches a known corrupted pattern
    #       (column-0, starts with corrupted_prefix, contains corrupted_suffix),
    #       replace it with correct_line at the same index, R082-verify, record.
    #
    # WHY: gdformat strips indentation from multi-line boolean expressions that
    #      span across what it considers a statement boundary. The result is a
    #      syntactically invalid GDScript line at column 0 inside a function body.
    #      This function detects and repairs that class of corruption regardless of
    #      how many chained '== "..."' tokens were previously appended.
    #
    # MENTAL MODEL BEFORE: script may contain lines starting at column 0 (no \t)
    #   that are if/elif statements which belong inside indented function bodies.
    #   gdlint/gdparse report "Unexpected token IF at line N, column 1."
    # MENTAL MODEL AFTER: all such lines have correct indentation matching their
    #   surrounding function body. gdparse exits 0 with no output.
    #
    # FAILURE MODE: if a corrupted_prefix matches 0 lines — already fixed or
    #   pattern not present in this file — logs [SKIP], continues. If it matches
    #   2+ lines — unexpected duplication — logs [WARN] and repairs all instances.
    #   R082 assert fires if any corrupted form remains after write.
    #
    # VERIFIES WITH: gdparse called by run_self_heal() after this function returns.
    #
    # Source (Tier 1): McConnell 2004 "Code Complete" 2nd ed. Ch.8 p.195:
    #   assert count==0 after write is the postcondition check.
    # Source (Tier 2): Python docs pathlib.Path.write_text:
    #   https://docs.python.org/3/library/pathlib.html#pathlib.Path.write_text

    file_name = script_path.name
    repairs = conn.execute(
        "SELECT repair_id, description, corrupted_prefix, corrupted_suffix, correct_line "
        "FROM known_repairs WHERE applies_to_file = ? OR applies_to_file IS NULL",
        (file_name,)
    ).fetchall()

    if not repairs:
        return True

    content = script_path.read_text(encoding="utf-8")
    lines = content.splitlines(keepends=True)
    changed = False
    before_sha = sha256(content)

    for row in repairs:
        repair_id = row['repair_id']
        description = row['description']
        prefix = row['corrupted_prefix']
        suffix = row['corrupted_suffix']
        correct = row['correct_line']

        # Detect: line at column 0 (no leading tab) matching prefix and suffix.
        # For simple repairs where prefix == suffix (exact-match repairs), detect
        # by exact content match at column 0.
        if prefix == suffix:
            # Exact-match: the corrupted line IS the prefix exactly
            indices = [
                i for i, l in enumerate(lines)
                if l.rstrip('\n') == prefix and not l.startswith('\t')
            ]
        else:
            # Prefix+suffix match: catches lines with arbitrary middle content
            # (e.g. the chained '== "mixamorig_LeftArm"' corruption)
            indices = [
                i for i, l in enumerate(lines)
                if l.startswith(prefix)
                and suffix in l
                and not l.startswith('\t')
            ]

        # Check if already correct — correct form already present at this position
        already_correct = [
            i for i, l in enumerate(lines)
            if l.rstrip('\n') == correct
        ]

        if not indices:
            if already_correct:
                log(f"[REPAIR-SKIP] {file_name}: already correct — {description}")
            else:
                log(f"[REPAIR-SKIP] {file_name}: pattern not present — {repair_id}")
            continue

        for idx in indices:
            log(f"[REPAIR] {file_name} line {idx+1}: {description}")
            log(f"  BEFORE: {repr(lines[idx][:100])}{'...' if len(lines[idx]) > 100 else ''}")
            lines[idx] = correct + "\n"
            log(f"  AFTER:  {repr(lines[idx])}")
            changed = True

    if changed:
        new_content = "".join(lines)
        script_path.write_text(new_content, encoding="utf-8")
        after_sha = sha256(new_content)

        # R082 read-back verification
        # Source (Tier 1): Gray & Reuter 1993 "Transaction Processing" Ch.10:
        #   "Read-after-write verification is mandatory for critical state changes."
        verify_lines = script_path.read_text(encoding="utf-8").splitlines()
        for row in repairs:
            prefix = row['corrupted_prefix']
            suffix = row['corrupted_suffix']
            if prefix == suffix:
                remaining = [l for l in verify_lines if l == prefix and not l.startswith('\t')]
            else:
                remaining = [l for l in verify_lines
                             if l.startswith(prefix) and suffix in l and not l.startswith('\t')]
            assert not remaining, (
                f"R082-FAIL: corrupted form still present after write in {file_name}: "
                f"repair_id={row['repair_id']}"
            )

        log(f"[R082-OK] {file_name}: all repairs verified by read-back.")
        record_applied_fix(
            conn,
            f"kaizen_repair_{file_name}_{before_sha[:8]}",
            str(script_path),
            "kaizen_repair_catalogue",
            before_sha,
            after_sha,
            run_id,
            "column0_indent_stripped"
        )
        record_mutation(conn, str(script_path), "kaizen_repair", before_sha, after_sha, 1)

    return True


# =============================================================================
# DEPENDENCY MANAGEMENT
# =============================================================================
def ensure_dependencies() -> bool:
    required = ["gdparse", "gdformat", "gdlint"]
    missing = [t for t in required if shutil.which(t) is None]
    if missing:
        log(f"[DEP] Missing: {missing} — installing gdtoolkit")
        r = subprocess.run([sys.executable, "-m", "pip", "install", "--upgrade", "gdtoolkit"],
                           capture_output=True, text=True, timeout=SUBPROCESS_TIMEOUT)
        if r.returncode != 0:
            log(f"[DEP-ERROR] pip install failed: {r.stderr}")
            return False
    for tool in required:
        r = subprocess.run([tool, "--version"], capture_output=True, text=True, timeout=SUBPROCESS_TIMEOUT)
        if r.returncode != 0:
            log(f"[DEP-ERROR] {tool} not available.")
            return False
        log(f"[DEP] {tool}: {r.stdout.strip()}")
    return True


# =============================================================================
# DATABASE HARDENING
# =============================================================================
def harden_database(conn: sqlite3.Connection) -> bool:
    log("[DB-HARDEN] Starting...")
    backup_path = DB_BACKUP_DIR / f"parachute_mutations_{datetime.now().strftime('%Y%m%d_%H%M%S')}.db"
    try:
        shutil.copy2(DB_PATH, backup_path)
        log(f"[DB-HARDEN] Backup: {backup_path}")
    except Exception as e:
        log(f"[DB-HARDEN] Backup failed: {e}")
        return False
    cur = conn.execute("PRAGMA integrity_check")
    if cur.fetchone()[0] != "ok":
        log("[DB-HARDEN] Integrity check FAILED")
        return False
    conn.execute("REINDEX")
    conn.execute("VACUUM")
    log("[DB-HARDEN] Reindex & vacuum completed.")
    return True


# =============================================================================
# SELF-HEAL LOOP
# =============================================================================
def run_self_heal(conn: sqlite3.Connection, run_id: int) -> bool:
    # WHAT: for each iteration — gdformat all scripts, apply_known_repairs on each,
    #       then gdlint+gdparse on each. Repeat until all pass or MAX_HEAL_ITERATIONS.
    #
    # WHY: apply_known_repairs() runs AFTER gdformat on each file so gdformat
    #      cannot re-corrupt a line that was just fixed. In v6.5.206 the fix ran
    #      once per iteration after ALL gdformat calls, giving gdformat the
    #      opportunity to re-corrupt in the same iteration pass.
    #
    # MENTAL MODEL BEFORE: gdformat may strip indentation from boolean expressions
    #   that span lines; corrupted lines appear at column 0 in function bodies.
    # MENTAL MODEL AFTER: every file passes gdlint and gdparse with rc=0.
    #
    # FAILURE MODE: if a script fails all MAX_HEAL_ITERATIONS, logs [HEAL-FAIL]
    #   and returns False. Caller aborts pipeline and dumps DB.
    #
    # Source (Tier 1): Shore 2004 "The Art of Agile Development" Ch.9:
    #   "Self-healing systems detect and repair their own errors automatically."

    files = sorted(SCRIPTS_DIR.glob("*.gd"))
    log(f"\n=== SELF-HEAL: {len(files)} scripts, max {MAX_HEAL_ITERATIONS} iterations ===")

    all_pass = False
    iteration = 0

    while iteration < MAX_HEAL_ITERATIONS and not all_pass:
        iteration += 1
        log(f"\n[HEAL] Iteration {iteration}/{MAX_HEAL_ITERATIONS}")
        iteration_pass = True

        for script in files:
            # Step A: gdformat
            log(f"  [gdformat] {script.name}")
            try:
                subprocess.run(
                    ["gdformat", str(script)],
                    capture_output=True, text=True, timeout=SUBPROCESS_TIMEOUT
                )
            except subprocess.TimeoutExpired:
                log(f"  [gdformat] TIMEOUT on {script.name}")
                iteration_pass = False
                continue

            # Step B: apply known repairs IMMEDIATELY after gdformat on this file
            # This prevents gdformat from re-corrupting a line fixed in a prior step.
            apply_known_repairs(script, conn, run_id)

        # Step C: gdlint + gdparse on all files
        for script in files:
            path_str = str(script)
            script_ok = True
            log(f"  [check] {script.name}")

            # --- gdlint: STYLE gate — warnings only, never blocks pipeline ---
            # WHAT: run gdlint for style feedback; rc!=0 is logged and recorded
            #       but does NOT set script_ok=False. Only gdparse (syntax) blocks.
            # WHY: gdlint enforces naming conventions and line-count limits that
            #      have no effect on whether Godot can parse and execute the file.
            #      Blocking on style prevents the game state test from running even
            #      when the file is syntactically correct. gdparse is the correctness
            #      gate; gdlint is the improvement backlog.
            # Source (Tier 1): McConnell 2004 "Code Complete" 2nd ed. Ch.22 p.522:
            #   "Separate correctness checks from style checks. Fail on correctness;
            #    warn on style."
            try:
                lint_result = subprocess.run(
                    ["gdlint", path_str],
                    capture_output=True, text=True, timeout=SUBPROCESS_TIMEOUT
                )
            except subprocess.TimeoutExpired:
                log(f"  [timeout] gdlint on {script.name}")
                lint_result = None

            if lint_result is not None:
                lint_output = lint_result.stdout + lint_result.stderr
                if lint_output.strip():
                    if lint_result.returncode != 0:
                        log(f"  gdlint WARN on {script.name} (rc={lint_result.returncode}) — style only, not blocking")
                        log(f"  gdlint output:\n{lint_output}")
                    else:
                        log(f"  gdlint output:\n{lint_output}")
                else:
                    log(f"  gdlint: no output (rc={lint_result.returncode})")
                conn.execute(
                    "INSERT INTO parse_checks (file_path, parser, return_code, output) "
                    "VALUES (?, ?, ?, ?)",
                    (path_str, "gdlint", lint_result.returncode, lint_output)
                )
                conn.commit()
                if lint_result.returncode != 0:
                    # Record style issues for v6.5.208 fix pass but do not block
                    for line in lint_output.splitlines():
                        m = re.search(r'(\d+):\s*(Error|Warning):\s*(.+)', line)
                        if m:
                            line_num = int(m.group(1))
                            snippet = get_source_snippet(path_str, line_num)
                            record_heal(
                                conn, run_id, path_str, line_num,
                                "gdlint_style_warn", line[:200], "STYLE_WARN", snippet
                            )

            # --- gdparse: CORRECTNESS gate — rc!=0 blocks pipeline ---
            # WHAT: gdparse validates GDScript syntax as Godot's parser sees it.
            #       rc!=0 means Godot cannot load the file — this blocks the pipeline.
            # WHY: a file that fails gdparse will cause Godot to print a parse error
            #      and skip the script entirely, breaking game state.
            # Source (Tier 2): gdtoolkit docs — gdparse mirrors Godot 4 parser:
            #   https://github.com/Scony/godot-gdscript-toolkit
            try:
                parse_result = subprocess.run(
                    ["gdparse", path_str],
                    capture_output=True, text=True, timeout=SUBPROCESS_TIMEOUT
                )
            except subprocess.TimeoutExpired:
                log(f"  [timeout] gdparse on {script.name}")
                script_ok = False
                parse_result = None

            if parse_result is not None:
                parse_output = parse_result.stdout + parse_result.stderr
                if parse_output.strip():
                    log(f"  gdparse output:\n{parse_output}")
                else:
                    log(f"  gdparse: no output (rc={parse_result.returncode})")

                conn.execute(
                    "INSERT INTO parse_checks (file_path, parser, return_code, output) "
                    "VALUES (?, ?, ?, ?)",
                    (path_str, "gdparse", parse_result.returncode, parse_output)
                )
                conn.commit()

                if parse_result.returncode != 0:
                    script_ok = False
                    log(f"  gdparse FAILED on {script.name} (rc={parse_result.returncode})")
                    for line in parse_output.splitlines():
                        m = re.search(r'(\d+):\s*(Error|Warning):\s*(.+)', line)
                        if m:
                            line_num = int(m.group(1))
                            snippet = get_source_snippet(path_str, line_num)
                            record_heal(
                                conn, run_id, path_str, line_num,
                                "gdparse_error", line[:200], "FAIL", snippet
                            )
                    # Record any new column-0 patterns as kaizen candidates
                    col0_new = [
                        l.rstrip() for l in parse_output.splitlines()
                        if l and not l.startswith('\t') and l.startswith('if ')
                        and 'Unexpected token' not in l
                    ]
                    for unknown in col0_new:
                        log(f"[KAIZEN-CANDIDATE] New column-0 pattern in {script.name}: {repr(unknown[:80])}")
                        log(f"[KAIZEN-CANDIDATE] Add to kaizen_repair_catalogue() and re-run v6.5.208+")
                        record_heal(
                            conn, run_id, path_str, 0,
                            "unknown_column0_pattern", unknown[:200],
                            "KAIZEN_CANDIDATE"
                        )
                else:
                    record_heal(conn, run_id, path_str, 0, "gdparse_ok", "passed", "PARSE_PASS")

            if not script_ok:
                iteration_pass = False
                log(f"  [FAIL] {script.name} has errors")

        if iteration_pass:
            all_pass = True
            log("[HEAL-OK] All scripts passed all checks.")
        else:
            log(f"[HEAL] Some failures remain; iteration {iteration}.")

    if all_pass:
        log("[HEAL-OK] All scripts passed after self-heal.")
    else:
        log("[HEAL-FAIL] Some scripts still have issues after max iterations.")

    return all_pass


