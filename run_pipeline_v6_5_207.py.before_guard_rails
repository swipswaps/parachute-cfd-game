def fix_project_godot(conn: sqlite3.Connection, run_id: int) -> None:
    log("[PATCH-PROJECT] Fixing project.godot...")
    content = PROJECT_GODOT.read_text(encoding="utf-8")
    original = content

    autoloads = [
        'InputManager="*res://scripts/InputManager.gd"',
        'PerformanceMonitor="*res://scripts/PerformanceMonitor.gd"',
        'GameIntegrity="*res://scripts/GameIntegrity.gd"',
        'AltimeterHUD="*res://scripts/altimeter_hud.gd"',
        'ForensicHUD="*res://scripts/forensic_hud.gd"',
        'Audit="*res://scripts/audit.gd"',
        'WindField="*res://scripts/wind_field.gd"',
    ]
    for autoload in autoloads:
        if autoload not in content:
            content = re.sub(r'(\[autoload\][^\n]*\n)', r'\1' + autoload + '\n', content, count=1)
            record_heal(conn, run_id, str(PROJECT_GODOT), 0, "add_autoload", f"Added {autoload}", "APPLIED")

    content = re.sub(r'\w+=\{\n"deadzone": 0\.5,\n"events": \[\n\]\n\}\n', '', content)
    content = re.sub(r'\w+=\{ "deadzone": 0\.5, "events": \[\],\s*\}\n', '', content)

    if content != original:
        PROJECT_GODOT.write_text(content, encoding="utf-8")
        record_mutation(conn, str(PROJECT_GODOT), "project_fixes", sha256(original), sha256(content), 1)
        log("[PATCH-PROJECT] project.godot fixed.")
    else:
        log("[PATCH-PROJECT] No changes needed.")


def fix_camera_look_at(conn: sqlite3.Connection, run_id: int) -> None:
    # WHAT: add _camera.look_at() after the "Camera attached" print if not present.
    # WHY: idempotency guard — check both that the trigger line exists AND that
    #      look_at is not already on the next line before replacing.
    #      v6.5.206 had no idempotency guard; re-running would duplicate the line.
    log("[FIX-CAMERA] Checking camera look_at...")
    script = SCRIPTS_DIR / "build_terrain.gd"
    content = script.read_text(encoding="utf-8")
    trigger = '\tprint("[VERBATIM] Camera attached")\n'
    insertion = '\t_camera.look_at(_plane_node.global_position, Vector3.UP)\n'
    already_present = trigger + insertion

    if already_present in content:
        log("[FIX-CAMERA] look_at already present — skipping.")
        return
    if trigger in content:
        content = content.replace(trigger, already_present)
        script.write_text(content, encoding="utf-8")
        # R082 read-back
        verify = script.read_text(encoding="utf-8")
        assert already_present in verify, "R082-FAIL: camera look_at not found after write"
        record_heal(conn, run_id, str(script), 0, "camera_look_at",
                    "Added look_at after camera attach", "APPLIED")
        log("[FIX-CAMERA] Added camera look_at to plane.")
    else:
        log("[FIX-CAMERA] 'Camera attached' line not found — skipping.")


