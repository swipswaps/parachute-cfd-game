def run_observable(conn: sqlite3.Connection, run_id: int) -> bool:
    if not OBSERVABLE_RUNNER.exists():
        log("[RUN-ERROR] observable_runner_v2.py missing")
        return False
    cmd = [
        sys.executable, str(OBSERVABLE_RUNNER),
        "--cmd", "/usr/bin/godot --path ./godot_project --quit-after 20",
        "--log-file", str(AUDIT_LOGS / "pipeline_final.log"),
        "--heartbeat", "5", "--timeout", "35", "--stall-detection", "25",
    ]
    log(f"[RUN] {' '.join(cmd)}")
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        log("[RUN] TIMEOUT")
        return False
    log(f"STDOUT:\n{r.stdout}")
    if r.stderr:
        log(f"STDERR:\n{r.stderr}")
    log(f"RETURN CODE: {r.returncode}")
    return r.returncode == 0


def run_game_state_test(conn: sqlite3.Connection, run_id: int) -> bool:
    log("[TEST] Running game state test...")
    cmd = ["/usr/bin/godot", "--path", "./godot_project", "--quit-after", "20"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, cwd=str(REPO_ROOT), timeout=35)
    except subprocess.TimeoutExpired:
        log("[TEST] TIMEOUT")
        return False
    stdout = r.stdout
    log(f"STDOUT:\n{stdout}")
    if r.stderr:
        log(f"STDERR:\n{r.stderr}")
    log(f"RETURN CODE: {r.returncode}")

    plane_created = "Plane node created" in stdout
    camera_attached = "Camera attached" in stdout

    log(f"[TEST] Plane created: {plane_created}")
    log(f"[TEST] Camera attached: {camera_attached}")

    states = [int(m.group(1)) for m in re.finditer(r'game_state=(\d+)', stdout)]
    game_state = states[-1] if states else -1
    conn.execute(
        "INSERT INTO game_state_log (run_id, game_state, altitude, is_deployed, error) "
        "VALUES (?, ?, ?, ?, ?)",
        (run_id, game_state, 0.0, 1 if 1 in states else 0,
         f"plane={plane_created} camera={camera_attached}")
    )
    conn.commit()
    return plane_created and camera_attached


# =============================================================================
# DIAGNOSTIC DUMP
# =============================================================================
def dump_all_tables(conn: sqlite3.Connection) -> None:
    log("\n" + "=" * 72)
    log(" FINAL DATABASE DUMP (all tables)")
    log("=" * 72)
    tables = conn.execute(
        "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name"
    ).fetchall()
    for (table_name,) in tables:
        rows = conn.execute(f"SELECT * FROM [{table_name}]").fetchall()
        log(f"\n--- TABLE {table_name} ({len(rows)} rows) ---")
        if not rows:
            log("  (empty)")
        else:
            cols = conn.execute(f"PRAGMA table_info({table_name})").fetchall()
            col_names = [c[1] for c in cols]
            log(f"Columns: {col_names}")
            for r in rows:
                log(str(dict(r)))


def dump_latest_run_summary(conn: sqlite3.Connection) -> None:
    log("\n" + "=" * 72)
    log(" LATEST RUN SUMMARY")
    log("=" * 72)

    run = conn.execute(
        "SELECT * FROM pipeline_runs ORDER BY run_id DESC LIMIT 1"
    ).fetchone()
    if run:
        log(f"Run: {dict(run)}")
    else:
        log("No runs found.")

    log("\n--- applied_fixes (last 20) ---")
    rows = conn.execute(
        "SELECT * FROM applied_fixes ORDER BY id DESC LIMIT 20"
    ).fetchall()
    for r in rows:
        log(str(dict(r)))

    log("\n--- known_repairs ---")
    rows = conn.execute("SELECT repair_id, description, correct_line FROM known_repairs").fetchall()
    for r in rows:
        log(str(dict(r)))


# =============================================================================
# MAIN PIPELINE
# =============================================================================
def main():
    log(f"=== Pipeline {VERSION} ===")
    log("DB-backed kaizen repair catalogue; no fix_build_terrain_directly().")
    log(f"START: {datetime.now().isoformat()}")

    subprocess.run(["pkill", "-f", "godot"], check=False)

    if not ensure_dependencies():
        log("[ERROR] Dependencies missing. Aborting.")
        sys.exit(1)

    conn = get_conn()
    if not harden_database(conn):
        log("[ERROR] Database hardening failed. Aborting.")
        sys.exit(1)

    ensure_schema(conn)

    # Seed known_repairs table — idempotent, INSERT OR IGNORE
    kaizen_repair_catalogue(conn)

    run_id = open_run(conn)

    try:
        log("\n[1/5] Apply fixes...")
        fix_project_godot(conn, run_id)
        fix_camera_look_at(conn, run_id)

        log("\n[2/5] Self-heal all scripts...")
        if not run_self_heal(conn, run_id):
            close_run(conn, run_id, "FAIL", "self_heal")
            dump_all_tables(conn)
            dump_latest_run_summary(conn)
            conn.close()
            sys.exit(1)

        close_run(conn, run_id, "running", "self_heal_complete")

        log("\n[3/5] Observable runner...")
        if not run_observable(conn, run_id):
            close_run(conn, run_id, "FAIL", "observable_runner")
            dump_all_tables(conn)
            dump_latest_run_summary(conn)
            conn.close()
            sys.exit(1)

        log("\n[4/5] Game state test...")
        if not run_game_state_test(conn, run_id):
            close_run(conn, run_id, "FAIL", "game_state_test")
            dump_all_tables(conn)
            dump_latest_run_summary(conn)
            conn.close()
            sys.exit(1)

        log("\n[5/5] Finalizing...")
        close_run(conn, run_id, "SUCCESS", "complete")

        dump_all_tables(conn)
        dump_latest_run_summary(conn)

        log(f"\nEND: {datetime.now().isoformat()}")
        log("[PIPELINE] All steps completed successfully.")

    except Exception as e:
        import traceback
        log(f"[FATAL] {e}")
        log(traceback.format_exc())
        close_run(conn, run_id, "EXCEPTION", str(e)[:100])
        dump_all_tables(conn)
        dump_latest_run_summary(conn)
        conn.close()
        sys.exit(1)

    conn.close()


if __name__ == "__main__":
    main()
