# WHAT: Pipeline v6.5.207 — removes fix_build_terrain_directly() which caused
#       exponential string growth; replaces it with kaizen_repair_catalogue()
#       (DB-backed known_repairs table) and apply_known_repairs() which uses
#       index-based line replacement with R082 read-back verification.
#
# RUN:  sudo HEADLESS=0 python3 run_pipeline_v6_5_207.py 2>&1 | ts | tee pipeline_run.log
