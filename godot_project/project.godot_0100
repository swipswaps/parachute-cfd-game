; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Parachute Landing Pattern v314"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6")
boot_splash="res://assets/boot_splash.png"
boot_splash_bg_color=Color(0, 0, 0, 1)

[autoload]

# Database infrastructure - LOAD FIRST
DatabaseGuard="*res://scripts/DatabaseGuard.gd"
ResourceThrottle="*res://scripts/ResourceThrottle.gd"

# Core database
SqliteDb="*res://scripts/SqliteDb.gd"
SqliteWatchdog="*res://scripts/SqliteWatchdog.gd"

# Monitoring (uses DatabaseGuard and ResourceThrottle)
PerformanceMonitor="*res://scripts/PerformanceMonitor.gd"

# Logging and utilities
StructuredLogger="*res://scripts/StructuredLogger.gd"
InputManager="*res://scripts/InputManager.gd"
GameIntegrity="*res://scripts/GameIntegrity.gd"

# HUD and UI
AltimeterHUD="*res://scripts/altimeter_hud.gd"
ForensicHUD="*res://scripts/forensic_hud.gd"
Audit="*res://scripts/audit.gd"

# Physics and environment
WindField="*res://scripts/wind_field.gd"
AeroUnits="*"

[display]

display/window/transparent=false

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_aerodynamic_physics/plugin.cfg")
plugins/godot-sqlite/plugin.cfg="*"

[environment]

defaults/default_environment=""
ambient_light/color=Color(1, 1, 1, 1)
ambient_light/energy=1.0
defaults/default_clear_color=Color(0.3, 0.5, 0.7, 1)

[gdextension]

path="res://addons/godot-sqlite/gdsqlite.gdextension"

[input]

cutaway={"deadzone": 0.5, "events": [{"device": 0, "index": 0, "key": 88, "pressed": true, "type": "key"}]}
cycle_camera={"deadzone": 0.5, "events": [{"device": 0, "index": 0, "key": 67, "pressed": true, "type": "key"}]}
deploy={"deadzone": 0.5, "events": [{"device": 0, "index": 0, "key": 32, "pressed": true, "type": "key"}]}
flare={"deadzone": 0.5, "events": [{"device": 0, "index": 0, "key": 70, "pressed": true, "type": "key"}]}
flight_check={"deadzone": 0.5, "events": [{"device": 0, "index": 0, "key": 290, "pressed": true, "type": "key"}]}
pause={"deadzone": 0.5, "events": [{"device": 0, "index": 0, "key": 27, "pressed": true, "type": "key"}]}
reserve={"deadzone": 0.5, "events": [{"device": 0, "index": 0, "key": 86, "pressed": true, "type": "key"}]}
restart={"deadzone": 0.5, "events": [{"device": 0, "index": 0, "key": 82, "pressed": true, "type": "key"}]}
toggle_hud={"deadzone": 0.5, "events": [{"device": 0, "index": 0, "key": 72, "pressed": true, "type": "key"}]}
turn_left={"deadzone": 0.5, "events": [{"device": 0, "index": 0, "key": 81, "pressed": true, "type": "key"}]}
turn_right={"deadzone": 0.5, "events": [{"device": 0, "index": 0, "key": 69, "pressed": true, "type": "key"}]}

pitch_down={"deadzone": 0.5, "events": [{"type": "key", "keycode": 4194320}]}
pitch_up={"deadzone": 0.5, "events": [{"type": "key", "keycode": 4194318}]}
yaw_right={"deadzone": 0.5, "events": [{"type": "key", "keycode": 4194319}]}
yaw_left={"deadzone": 0.5, "events": [{"type": "key", "keycode": 4194317}]}
roll_right={"deadzone": 0.5, "events": [{"type": "key", "keycode": 101}]}
roll_left={"deadzone": 0.5, "events": [{"type": "key", "keycode": 113}]}
throttle_down={"deadzone": 0.5, "events": [{"type": "key", "keycode": 114}]}
throttle_up={"deadzone": 0.5, "events": [{"type": "key", "keycode": 102}]}
brake_up={"deadzone": 0.5, "events": [{"type": "key", "keycode": 98}]}
collective_down={"deadzone": 0.5, "events": [{"type": "key", "keycode": 99}]}
collective_up={"deadzone": 0.5, "events": [{"type": "key", "keycode": 118}]}

[layer_names]

3d_physics/layer_15="Atmosphere Areas"

[rendering]

renderer/rendering_method="gl_compatibility"