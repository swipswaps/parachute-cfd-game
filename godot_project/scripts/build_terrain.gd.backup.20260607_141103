var _controller_connected: bool = false
var _controller_input_map: Dictionary = {}

# ==================================================================
#  _READY — ENTRY POINT, ALL GATES ACTIVATED
# ==================================================================
func _ready() -> void:
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " ENTER _ready gate=none")
	_setup_terrain()
	_setup_runways()
	_setup_character()
	_setup_camera()
	_setup_drop_zone()
	_setup_hud()
	_setup_pip_overlay()
	_init_achievements()
	_init_mission()
	_init_leaderboard()
	_init_controller()
	_init_sentry()
	_start_recording()
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " EXIT _ready ok=true")

# -------------------------------------- TERRAIN ---------------------------------------
func _setup_terrain() -> void:
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " ENTER _setup_terrain gate=none")
	var noise = FastNoiseLite.new()
	noise.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	noise.seed = randi()
	var img = Image.create(TERRAIN_SIZE, TERRAIN_SIZE, false, Image.FORMAT_RGBAF)
	for x in TERRAIN_SIZE:
		for z in TERRAIN_SIZE:
			var h = noise.get_noise_2d(x, z) * TERRAIN_HEIGHT_SCALE
			img.set_pixel(x, z, Color(h / 255.0, 0.5, 0.2, 1.0))
	var texture = ImageTexture.create_from_image(img)
	var material = StandardMaterial3D.new()
	material.albedo_texture = texture
	var mesh = PlaneMesh.new()
	mesh.size = Vector2(TERRAIN_SIZE, TERRAIN_SIZE)
	mesh.subdivision_width = TERRAIN_SIZE - 1
	mesh.subdivision_depth = TERRAIN_SIZE - 1
	_terrain_mesh = MeshInstance3D.new()
	_terrain_mesh.mesh = mesh
	_terrain_mesh.material_override = material
	add_child(_terrain_mesh)
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " EXIT _setup_terrain ok=true")

func _setup_runways() -> void:
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " ENTER _setup_runways gate=none")
	var runway_mat = StandardMaterial3D.new()
	runway_mat.albedo_color = Color(0.3, 0.3, 0.3)
	for pos in [Vector3(-200, 0.05, -100), Vector3(200, 0.05, 100)]:
		var rw = MeshInstance3D.new()
		var box = BoxMesh.new()
		box.size = Vector3(40, 0.1, 200)
		rw.mesh = box
		rw.position = pos
		rw.material_override = runway_mat
		add_child(rw)
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " EXIT _setup_runways ok=true")

# -------------------------------------- CHARACTER + ARMS ------------------------------
func _setup_character() -> void:
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " ENTER _setup_character gate=none")
	var fbx_path = "res://assets/characters/parachutist.fbx"
	if not ResourceLoader.exists(fbx_path):
		fbx_path = "res://assets/characters/parachutist.glb"
	var scene = load(fbx_path)
	if not scene:
		print("[VERBATIM] ", Time.get_datetime_string_from_system(), " EXIT _setup_character early=fbx_missing")
		return
	_character = scene.instantiate()
	add_child(_character)
	_character.position = Vector3(100.0, 250.0, -100.0)
	_skeleton = _character.find_child("Skeleton3D", true, false)
	if _skeleton:
		for i in _skeleton.get_bone_count():
			var name = _skeleton.get_bone_name(i)
			if name.contains("LeftArm"):
				_left_arm_idx = i
				print("[VERBATIM] ", Time.get_datetime_string_from_system(), " bone LEFT_ARM found idx=", i, " name=", name)
			if name.contains("RightArm"):
				_right_arm_idx = i
				print("[VERBATIM] ", Time.get_datetime_string_from_system(), " bone RIGHT_ARM found idx=", i, " name=", name)
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " EXIT _setup_character ok=true")

func _rotate_arm(left: bool) -> void:
	var angle = -0.65 if left else -0.65   # rad, pull down
	if left and _left_arm_idx != -1:
		_left_arm_angle = move_toward(_left_arm_angle, angle, 0.1)
		var q = Quaternion(Vector3.RIGHT, _left_arm_angle)
		_skeleton.set_bone_pose_rotation(_left_arm_idx, q)
		print("[VERBATIM] ", Time.get_datetime_string_from_system(), " left arm angle=", _left_arm_angle)
	elif not left and _right_arm_idx != -1:
		_right_arm_angle = move_toward(_right_arm_angle, angle, 0.1)
		var q = Quaternion(Vector3.RIGHT, _right_arm_angle)
		_skeleton.set_bone_pose_rotation(_right_arm_idx, q)
		print("[VERBATIM] ", Time.get_datetime_string_from_system(), " right arm angle=", _right_arm_angle)

# -------------------------------------- CAMERA (local space) --------------------------
func _setup_camera() -> void:
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " ENTER _setup_camera gate=none")
	_camera = Camera3D.new()
	_camera.position = Vector3(0.0, 2.0, 3.0)   # 2m up, 3m behind (local)
	_camera.fov = 75.0
	_camera.near = 0.1
	_camera.far = 10000.0
	_character.add_child(_camera)
	# look at chest (local y=1.0) — character not yet in scene tree, use local target
	_camera.look_at(Vector3(0.0, 1.0, 0.0), Vector3.UP)
	_camera.current = true
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " EXIT _setup_camera ok=true")

func _cycle_camera() -> void:
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " ENTER _cycle_camera gate=none")
	if not _camera: return
	_cam_angle_idx = (_cam_angle_idx + 1) % 4
	match _cam_angle_idx:
		0:
			_camera.position = Vector3(0.0, 2.0, 3.0)
			_camera.rotation = Vector3(deg_to_rad(-10.0), 0.0, 0.0)
			print("[VERBATIM] camera=BEHIND (0,2,3)")
		1:
			_camera.position = Vector3(6.0, 1.0, 0.0)
			_camera.rotation = Vector3(0.0, deg_to_rad(-90.0), 0.0)
			print("[VERBATIM] camera=SIDE (6,1,0)")
		2:
			_camera.position = Vector3(0.0, 1.8, 0.0)
			_camera.rotation = Vector3(deg_to_rad(90.0), 0.0, 0.0)
			print("[VERBATIM] camera=PILOT_UP (0,1.8,0)")
		3:
			_camera.position = Vector3(0.0, 0.5, 1.5)
			_camera.rotation = Vector3(deg_to_rad(-5.0), 0.0, 0.0)
			print("[VERBATIM] camera=CHASE_CLOSE (0,0.5,1.5)")
	print("[VERBATIM] EXIT _cycle_camera ok=true")

# -------------------------------------- DROP ZONE -------------------------------------
func _setup_drop_zone() -> void:
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " ENTER _setup_drop_zone gate=none")
	var cyl = CylinderMesh.new()
	cyl.top_radius = 5.0      # R080 – 5m radius, not excessive
	cyl.bottom_radius = 5.0
	cyl.height = 0.2
	var mat = StandardMaterial3D.new()
	mat.albedo_color = Color.YELLOW
	_drop_zone = MeshInstance3D.new()
	_drop_zone.mesh = cyl
	_drop_zone.material_override = mat
	_drop_zone.position = Vector3(0.0, 0.1, 0.0)
	add_child(_drop_zone)
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " EXIT _setup_drop_zone ok=true")

# -------------------------------------- HUD (custom minimum size) ---------------------
func _setup_hud() -> void:
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " ENTER _setup_hud gate=none")
	_hud_layer = CanvasLayer.new()
	add_child(_hud_layer)
	var font_size = 14
	var labels = ["ALT", "SPD | VARIO", "HDG", "BRG", "TURN", LegLabel, "MALF", "EP"]
	for i in labels.size():
		var lbl = Label.new()
		lbl.add_theme_font_size_override("font_size", font_size)
		lbl.add_theme_color_override("font_color", Color.GREEN)
		lbl.position = Vector2(10, 10 + i * 22)
		lbl.custom_minimum_size = Vector2(220, 20)   # R079 – prevents clipping
		lbl.text = labels[i] + ": --"
		_hud_layer.add_child(lbl)
		_hud_labels.append(lbl)
	_notification_label = Label.new()
	_notification_label.add_theme_color_override("font_color", Color.YELLOW)
	_notification_label.position = Vector2(10, 220)
	_hud_layer.add_child(_notification_label)
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " EXIT _setup_hud ok=true")

func _toggle_hud() -> void:
	if not _hud_layer: return
	_hud_visible = not _hud_visible
	_hud_layer.visible = _hud_visible
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " HUD toggled visible=", _hud_visible)

# -------------------------------------- PIP OVERLAY (isolated world, second canopy) ---
func _setup_pip_overlay() -> void:
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " ENTER _setup_pip_overlay gate=none")
	var layer = CanvasLayer.new()
	layer.name = "PiPLayer"
	add_child(layer)
	var container = SubViewportContainer.new()
	container.size = Vector2(320, 240)
	container.position = Vector2(20, 20)
	container.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.add_child(container)
	_pip_viewport = SubViewport.new()
	_pip_viewport.size = Vector2i(320, 240)
	_pip_viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	container.add_child(_pip_viewport)
	# Load canopy GLB (must have .import sidecar – assume already imported)
	var canopy_path = "res://assets/canopy/parachute_sanitized.glb"
	if not ResourceLoader.exists(canopy_path):
		canopy_path = "res://assets/canopy/parachute.glb"
	var canopy_scene = load(canopy_path) if ResourceLoader.exists(canopy_path) else null
	if not canopy_scene:
		print("[VERBATIM] ", Time.get_datetime_string_from_system(), " EXIT _setup_pip_overlay early=canopy_missing")
		return
	# PiP canopy instance (isolated world)
	_pip_canopy_node = canopy_scene.instantiate()
	_pip_viewport.add_child(_pip_canopy_node)
	_pip_canopy_node.position = Vector3(0.0, 5.0, 0.0)
	# PiP camera looking up (pilot eye view)
	_pip_camera = Camera3D.new()
	_pip_camera.position = Vector3(0.0, 1.8, 0.0)   # head height
	_pip_camera.look_at_from_position(
		Vector3(0.0, 1.8, 0.0),
		Vector3(0.0, 5.0, 0.0),
		Vector3.FORWARD
	)
	_pip_camera.fov = 110.0
	_pip_viewport.add_child(_pip_camera)
	_pip_camera.current = true
	# Add a directional light inside PiP
	var light = DirectionalLight3D.new()
	light.rotation = Vector3(deg_to_rad(-45), deg_to_rad(30), 0)
	_pip_viewport.add_child(light)
	# SECOND canopy instance for main scene (R084 – isolated worlds require separate copy)
	var main_canopy = canopy_scene.instantiate()
	main_canopy.position = Vector3(0.0, 2.5, 0.0)
	_character.add_child(main_canopy)
	_main_canopy_node = main_canopy
	print("[VERBATIM] ", Time.get_datetime_string_from_system(), " EXIT _setup_pip_overlay ok=true")

# -------------------------------------- WIND (CFD + NOAA) -----------------------------
func _update_cfd_wind(delta: float) -> void:
	var altitude_m = _current_altitude * 0.3048
	var wind_speed_at_alt = _wind_base_speed * (1.0 + 0.1 * log(1.0 + altitude_m / 10.0))
	_wind_gust_time += delta
	if _wind_gust_time > randf_range(5.0, 10.0):
		_wind_gust_time = 0.0
		_wind_current_gust = randf_range(-_wind_turbulence, _wind_turbulence)
	var final_speed = max(0.0, wind_speed_at_alt + _wind_current_gust)
	var wind_rad = deg_to_rad(_wind_base_direction)
	var wind_vec: Vector3 = Vector3(sin(wind_rad), 0, cos(wind_rad)) * (final_speed * 0.514444)
	if _game_state == GameState.DIAGNOSIS:
		_velocity_vec += wind_vec * delta * 0.5
	print("[VERBATIM] CFD wind: speed ", final_speed, " kts, dir ", _wind_base_direction, "°, gust ", _wind_current_gust)

func _fetch_real_wind() -> void:
	var http = HTTPRequest.new()
	add_child(http)
	http.request_completed.connect(_on_wind_received)
	http.request("https://api.weather.gov/points/29.067,-81.284")

func _on_wind_received(result: int, code: int, headers: PackedStringArray, body: PackedByteArray) -> void:
	if code != 200: return
	var json = JSON.parse_string(body.get_string_from_utf8())
	if not json: return
	var grid_url = json.get("properties", {}).get("forecast", "")
	if grid_url.is_empty(): return
	var http2 = HTTPRequest.new()
	add_child(http2)
	http2.request_completed.connect(_on_forecast_received)
	http2.request(grid_url)

func _on_forecast_received(result: int, code: int, headers: PackedStringArray, body: PackedByteArray) -> void:
	if code != 200: return
	var data = JSON.parse_string(body.get_string_from_utf8())
	if not data: return
	var periods = data.get("properties", {}).get("periods", [])
	if periods.is_empty(): return
	var wind_speed = periods[0].get("windSpeed", "8 mph")
	var wind_dir = periods[0].get("windDirection", "120")
	var speed_kts = wind_speed.to_float() * 0.868976
	_wind_base_speed = speed_kts
	_wind_base_direction = wind_dir.to_int()
	print("[VERBATIM] Real wind loaded: ", wind_dir, " ", speed_kts, " kts")

# -------------------------------------- MISSION, SCORING, ACHIEVEMENTS ----------------
func _init_mission() -> void:
	print("[VERBATIM] ENTER _init_mission gate=none")
	_mission_objectives = {
		MissionType.TRAINING: {"name":"Training","target_score":500,"target_malfunction":MalfunctionType.GOOD},
		MissionType.ADVANCED: {"name":"Advanced","target_score":800,"target_malfunction":MalfunctionType.LINE_TWISTS},
		MissionType.EXPERT: {"name":"Expert","target_score":950,"target_malfunction":null}
	}
	_update_mission_ui()
	print("[VERBATIM] EXIT _init_mission ok=true")

func _update_mission_ui() -> void:
	var info = _mission_objectives[_current_mission]
	_notification_label.text = "Mission: " + info["name"] + " | Target: " + str(info["target_score"])

func _check_mission_completion() -> void:
	if _mission_completed: return
	var info = _mission_objectives[_current_mission]
	if _score >= info["target_score"]:
		if info["target_malfunction"] == null or _malfunction == info["target_malfunction"]:
			_mission_completed = true
			print("[VERBATIM] Mission completed: ", info["name"])
			_show_notification("Mission completed: " + info["name"])
			match _current_mission:
				MissionType.TRAINING:
					_current_mission = MissionType.ADVANCED
				MissionType.ADVANCED:
					_current_mission = MissionType.EXPERT
			_update_mission_ui()

func _on_landing() -> void:
	print("[VERBATIM] ENTER _on_landing gate=_game_state")
	_game_state = GameState.LANDED
	# distance to drop zone
	var dist = Vector2(_character.position.x, _character.position.z).length()
	var accuracy = max(0, 100 - int(dist))
	_score = 500 + accuracy
	print("[VERBATIM] score=", _score, " accuracy_bonus=", accuracy, " dist_m=", dist)
	_update_leaderboard()
	_unlock_achievement("FIRST_LANDING")
	if dist <= 10.0:
		_unlock_achievement("ACCURACY_10M")
	_show_notification("Landed! Score: " + str(_score))

func _init_leaderboard() -> void:
	print("[VERBATIM] ENTER _init_leaderboard gate=none")
	_leaderboard = []
	print("[VERBATIM] EXIT _init_leaderboard ok=true")

func _update_leaderboard() -> void:
	_leaderboard.append(_score)
	_leaderboard.sort()
	_leaderboard.reverse()
	print("[VERBATIM] leaderboard updated size=", _leaderboard.size(), " top_score=", _leaderboard[0] if _leaderboard else 0)

func _init_achievements() -> void:
	print("[VERBATIM] ENTER _init_achievements gate=none")
	# load from file if needed
	print("[VERBATIM] EXIT _init_achievements ok=true")

func _unlock_achievement(id: String) -> void:
	if _achievements.has(id) and not _achievements[id]:
		_achievements[id] = true
		print("[VERBATIM] Achievement unlocked: ", id)
		_show_notification("Achievement: " + id)

# -------------------------------------- REPLAY ---------------------------------------
func _start_recording() -> void:
	_replay_recording.clear()
	_replay_recording.append({"action":"start","time":Time.get_ticks_msec()})

func _stop_recording() -> void:
	var file = FileAccess.open("user://replay.save", FileAccess.WRITE)
	file.store_string(JSON.stringify(_replay_recording))
	file.close()
	print("[VERBATIM] Replay saved with ", _replay_recording.size(), " frames")

func _play_replay() -> void:
	if not FileAccess.file_exists("user://replay.save"):
		print("[VERBATIM] No replay file")
		return
	var file = FileAccess.open("user://replay.save", FileAccess.READ)
	var content = file.get_as_text()
	_replay_recording = JSON.parse_string(content)
	_replay_playing = true
	_replay_index = 0
	print("[VERBATIM] Replay started")

func _process_replay(delta: float) -> void:
	if not _replay_playing: return
	if _replay_index >= _replay_recording.size():
		_replay_playing = false
		print("[VERBATIM] Replay finished")
		return
	var event = _replay_recording[_replay_index]
	if Time.get_ticks_msec() >= event["time"]:
		match event["action"]:
			"deploy": _deploy_canopy()
			"cutaway": _do_cutaway()
			"reserve": _do_reserve()
			"flare": _do_flare()
		_replay_index += 1

# -------------------------------------- CONTROLLER -----------------------------------
func _init_controller() -> void:
	print("[VERBATIM] ENTER _init_controller gate=none")
	Input.joy_connection_changed.connect(_on_joy_connection_changed)
	_check_controllers()
	print("[VERBATIM] EXIT _init_controller ok=true")

func _check_controllers() -> void:
	for i in Input.get_connected_joypads():
		_controller_connected = true
		print("[VERBATIM] Controller connected: ", Input.get_joy_name(i))
		break

func _on_joy_connection_changed(device_id: int, connected: bool) -> void:
	_controller_connected = connected
	print("[VERBATIM] Controller connection changed: device ", device_id, " connected: ", connected)

func _process_controller_input() -> void:
	if not _controller_connected: return
	_controller_input_map["turn_left"] = Input.is_joy_button_pressed(0, JOY_BUTTON_LEFT_SHOULDER)
	_controller_input_map["turn_right"] = Input.is_joy_button_pressed(0, JOY_BUTTON_RIGHT_SHOULDER)
	_controller_input_map["flight_check"] = Input.is_joy_button_pressed(0, JOY_BUTTON_A)
	_controller_input_map["cutaway"] = Input.is_joy_button_pressed(0, JOY_BUTTON_X)
	_controller_input_map["reserve"] = Input.is_joy_button_pressed(0, JOY_BUTTON_B)
	_controller_input_map["flare"] = Input.is_joy_button_pressed(0, JOY_BUTTON_Y)
	_controller_input_map["reset"] = Input.is_joy_button_pressed(0, JOY_BUTTON_START)

# -------------------------------------- SENTRY (stub) --------------------------------
func _init_sentry() -> void:
	print("[VERBATIM] ENTER _init_sentry gate=none")
	# real DSN would be set in ProjectSettings
	var dsn = ProjectSettings.get_setting("sentry/dsn", "")
	if dsn != "":
		_sentry_initialized = true
		print("[VERBATIM] Sentry initialized")
	else:
		print("[VERBATIM] Sentry not configured")
	print("[VERBATIM] EXIT _init_sentry ok=true")

func _report_error(msg: String, stack: String = "") -> void:
	if _sentry_initialized:
		print("[VERBATIM] Sending error to Sentry: ", msg)

# -------------------------------------- UTILITIES ------------------------------------
func _show_notification(text: String) -> void:
	_notification_label.text = text
	var timer = get_tree().create_timer(3.0)
	timer.timeout.connect(func(): _notification_label.text = "")

func _deploy_canopy() -> void:
	if _canopy_deployed: return
	_canopy_deployed = true
	_deployment_timer = DEPLOY_TIME
	print("[VERBATIM] Canopy deployed")

func _do_cutaway() -> void:
	if _cutaway_done: return
	_cutaway_done = true
	print("[VERBATIM] Cutaway performed")

func _do_reserve() -> void:
	if _reserve_done: return
	_reserve_done = true
	_deploy_canopy()
	print("[VERBATIM] Reserve deployed")

func _do_flare() -> void:
	if _flare_done: return
	_flare_done = true
	print("[VERBATIM] Flare applied")

func _flight_control_check() -> void:
	_flight_control_checked = true
	print("[VERBATIM] Flight control check passed")

func _randomize_malfunction() -> void:
	var r = randi() % 4
	match r:
		0: _malfunction = MalfunctionType.GOOD
		1: _malfunction = MalfunctionType.LINE_TWISTS
		2: _malfunction = MalfunctionType.BAG_LOCK
		3: _malfunction = MalfunctionType.BROKEN_LINES
	print("[VERBATIM] Malfunction set to ", _malfunction_name())

func _malfunction_name() -> String:
	match _malfunction:
		MalfunctionType.GOOD: return "Good"
		MalfunctionType.LINE_TWISTS: return "Line Twists"
		MalfunctionType.BAG_LOCK: return "Bag Lock"
		MalfunctionType.BROKEN_LINES: return "Broken Lines"
	return "Unknown"

func _reset_game() -> void:
	print("[VERBATIM] === RESETTING GAME ===")
	_game_state = GameState.FREEFALL
	_character.position = Vector3(100.0, 250.0, -100.0)
	_velocity_vec = Vector3.ZERO
	_forward_speed = 0.0
	_turn_input = 0.0
	_descent_rate = 0.0
	_current_altitude = 250.0
	_flight_control_checked = false
	_cutaway_done = false
	_reserve_done = false
	_flare_done = false
	_safe_landing = false
	_decision_altitude_warning_shown = false
	_canopy_deployed = false
	_deployment_timer = 0.0
	_score = 0
	_cam_angle_idx = 0
	_camera.position = Vector3(0.0, 2.0, 3.0)
	_camera.rotation = Vector3(deg_to_rad(-10.0), 0.0, 0.0)
	if _main_canopy_node: _main_canopy_node.visible = false
	_randomize_malfunction()
	_show_notification("Game reset")
	_start_recording()

# -------------------------------------- PHYSICS PROCESS (flight) ---------------------
func _physics_process(delta: float) -> void:
	_prev_descent_rate = _descent_rate
	var descent = 0.0
	match _game_state:
		GameState.FREEFALL:
			descent = 1.2 * 60.0 * delta
		GameState.OPENING_ANIM:
			descent = 0.3 * 60.0 * delta
		GameState.DIAGNOSIS:
			descent = _get_current_descent_rate() * 60.0 * delta
		_:
			descent = 0.0
	_character.position.y -= descent
	if _character.position.y < 25.0:
		_character.position.y = 25.0
		if not _safe_landing and _game_state != GameState.LANDED:
			_game_state = GameState.GAME_OVER
			print("[VERBATIM] Ground impact – fatal")
	_current_altitude = _character.position.y - 25.0
	_vario_mps = _prev_descent_rate - _descent_rate   # R082 variometry
	if _game_state == GameState.OPENING_ANIM and _canopy_deployed:
		if _deployment_timer > 0:
			_deployment_timer -= delta
			var t = 1.0 - (_deployment_timer / DEPLOY_TIME)
			if _main_canopy_node: _main_canopy_node.scale = Vector3(t, t, t)
		else:
			_game_state = GameState.DIAGNOSIS
			if _main_canopy_node: _main_canopy_node.scale = Vector3.ONE
			print("[VERBATIM] Canopy fully inflated")
	if _game_state == GameState.DIAGNOSIS:
		_poll_controls()
		_update_cfd_wind(delta)
		# forward flight toward drop zone (0,0)
		var target_dir = -_character.global_position.normalized()
		_forward_speed = move_toward(_forward_speed, _max_speed, _accel * delta)
		var turn_dir = Vector3.RIGHT * _turn_input * _turn_force
		_velocity_vec += turn_dir * delta
		var forward_vec = target_dir * _forward_speed
		_velocity_vec = _velocity_vec.move_toward(forward_vec, _accel * delta)
		_character.position += _velocity_vec * delta
		if _velocity_vec.length() > 0.5:
			var angle = atan2(_velocity_vec.x, _velocity_vec.z)
			_character.rotation = Vector3(0, angle, 0)
		var speed_kts = _forward_speed * 1.94384
		_hud_labels[0].text = "ALT: %.0f ft" % max(0, _current_altitude)
		_hud_labels[1].text = "SPD: %.0f kts | VARIO: %+.1f m/s" % [speed_kts, _vario_mps]
		_hud_labels[2].text = "HDG: %.0f°" % rad_to_deg(_character.rotation.y)
		var bearing = rad_to_deg(atan2(-_character.position.x, -_character.position.z))
		_hud_labels[3].text = "BRG: %.0f°" % bearing
		_hud_labels[4].text = "TURN: %d" % (_turn_input * 100)
		_hud_labels[5].text = LegLabel + ": " + ["DOWNWIND","BASE","FINAL"][_pattern_state]
		_hud_labels[6].text = "MALF: " + _malfunction_name()
		var ep = "Press C for FC"
		if _flare_done: ep = "FLARE ✓"
		elif _reserve_done: ep = "RESERVE ✓"
		elif _cutaway_done: ep = "CUTAWAY (need RESERVE)"
		elif _flight_control_checked: ep = "FC ✓"
		_hud_labels[7].text = "EP: " + ep
		_check_decision_altitude()
	_process_replay(delta)
	if _game_state == GameState.DIAGNOSIS and _current_altitude <= 0.0 and not _safe_landing:
		_on_landing()
		_safe_landing = true

func _get_current_descent_rate() -> float:
	if _game_state == GameState.FREEFALL: return 1.2
	if _game_state == GameState.OPENING_ANIM: return 0.3
	if _game_state != GameState.DIAGNOSIS: return 0.0
	if _reserve_done or _flare_done: return DESCENT_RATE_GOOD
	match _malfunction:
		MalfunctionType.BAG_LOCK: return DESCENT_RATE_BAGLOCK
		MalfunctionType.GOOD: return DESCENT_RATE_GOOD
		_: return DESCENT_RATE_NORMAL

func _check_decision_altitude() -> void:
	if _game_state != GameState.DIAGNOSIS: return
	if _current_altitude <= 2500.0 and not _decision_altitude_warning_shown:
		_decision_altitude_warning_shown = true
		print("[VERBATIM] DECISION ALTITUDE – 2500 ft!")
		_show_notification("DECISION ALTITUDE! Act now!")

# -------------------------------------- PROCESS LOOP (UI updates) --------------------
func _process(delta: float) -> void:
	if _game_state == GameState.GAME_OVER: return
	_frame_count += 1
	if _frame_count == 2:
		var ts = Time.get_datetime_string_from_system().replace(":","").replace("-","")
		var path = ProjectSettings.globalize_path("res://") + "../screenshot_" + ts + ".png"
		get_viewport().get_texture().get_image().save_png(path)
		print("[VERBATIM] Screenshot saved: ", path)
	var dist = _character.global_position.length()
	_update_pattern(_current_altitude, dist)
	_check_mission_completion()
	if _frame_count % 1800 == 0:
		_fetch_real_wind()

func _update_pattern(altitude: float, distance: float) -> void:
	var new_state = _pattern_state
	if altitude > 1000.0: new_state = PatternState.DOWNWIND
	elif altitude > 500.0: new_state = PatternState.BASE
	else: new_state = PatternState.FINAL
	if new_state != _pattern_state:
		_pattern_state = new_state
		_hud_labels[5].text = LegLabel + ": " + ["DOWNWIND","BASE","FINAL"][_pattern_state]
		print("[VERBATIM] Entering ", _hud_labels[5].text)

func _turn_left() -> void:
	_turn_target_heading -= _turn_rate
	_turn_target_heading = max(_initial_heading - 90.0, _turn_target_heading)
	print("[VERBATIM] Left turn target: ", _turn_target_heading)

func _turn_right() -> void:
	_turn_target_heading += _turn_rate
	_turn_target_heading = min(_initial_heading + 90.0, _turn_target_heading)
	print("[VERBATIM] Right turn target: ", _turn_target_heading)

# -------------------------------------- INPUT HANDLING --------------------------------
func _input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed:
		if event.button_index == MOUSE_BUTTON_WHEEL_UP:
			_camera.position.y = max(200.0, _camera.position.y - 50.0)
		elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
			_camera.position.y = min(2000.0, _camera.position.y + 50.0)
	if event is InputEventKey and event.pressed and not event.echo:
		match event.keycode:
			KEY_SPACE:
				if _game_state == GameState.FREEFALL and _current_altitude <= 4300 and _current_altitude >= 1500:
					_deploy_canopy()
					_game_state = GameState.OPENING_ANIM
					print("[VERBATIM] Rip cord pulled at alt=", _current_altitude)
			KEY_P: _play_replay()
			KEY_S: _stop_recording()
			KEY_R: _reset_game()

func _poll_controls() -> void:
	if _game_state == GameState.LANDED or _game_state == GameState.GAME_OVER:
		if Input.is_key_pressed(KEY_R): _reset_game()
		return
	var left = Input.is_key_pressed(KEY_Q)
	var right = Input.is_key_pressed(KEY_E)
	if left and not right:
		_turn_input = -1.0
		if not _last_frame_keys["Q"]: _rotate_arm(true)
	elif right and not left:
		_turn_input = 1.0
		if not _last_frame_keys["E"]: _rotate_arm(false)
	else:
		_turn_input = 0.0
	if Input.is_key_pressed(KEY_C) and not _cam_cycle_held:
		_cam_cycle_held = true
		_cycle_camera()
	elif not Input.is_key_pressed(KEY_C):
		_cam_cycle_held = false
	if Input.is_key_pressed(KEY_H) and not _hud_toggle_held:
		_hud_toggle_held = true
		_toggle_hud()
	elif not Input.is_key_pressed(KEY_H):
		_hud_toggle_held = false
	if Input.is_key_pressed(KEY_C) and not _last_frame_keys["C"]: _flight_control_check()
	if Input.is_key_pressed(KEY_X) and not _last_frame_keys["X"]: _do_cutaway()
	if Input.is_key_pressed(KEY_V) and not _last_frame_keys["V"]: _do_reserve()
	if Input.is_key_pressed(KEY_F) and not _last_frame_keys["F"]: _do_flare()
	_process_controller_input()
	_last_frame_keys["Q"] = left
	_last_frame_keys["E"] = right
	_last_frame_keys["C"] = Input.is_key_pressed(KEY_C)
	_last_frame_keys["X"] = Input.is_key_pressed(KEY_X)
	_last_frame_keys["V"] = Input.is_key_pressed(KEY_V)
	_last_frame_keys["F"] = Input.is_key_pressed(KEY_F)

