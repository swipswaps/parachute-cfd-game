extends Node

# ==================================================================
#  PARACHUTE SIMULATOR — build_terrain.gd
#  Godot 4.6.2
#  R071-R085 compliant, all gates satisfied.
# ==================================================================

enum GameState { FREEFALL, OPENING_ANIM, DIAGNOSIS, LANDED, GAME_OVER }
enum MalfunctionType { GOOD, LINE_TWISTS, BAG_LOCK, BROKEN_LINES }
enum MissionType { TRAINING, ADVANCED, EXPERT }
enum PatternState { DOWNWIND, BASE, FINAL }

# -------------------------------------- CONSTANTS --------------------------------------
const TERRAIN_SIZE := 1024
const TERRAIN_HEIGHT_SCALE := 80.0
const GRAVITY := 32.174  # ft/s²
const DEPLOY_TIME := 1.2  # seconds
const DESCENT_RATE_GOOD := 14.0  # ft/s
const DESCENT_RATE_BAGLOCK := 28.0
const DESCENT_RATE_NORMAL := 18.0

# -------------------------------------- NODE REFERENCES ---------------------------------
var _terrain_mesh: MeshInstance3D
var _character: Node3D
var _skeleton: Skeleton3D
var _camera: Camera3D
var _drop_zone: MeshInstance3D
var _hud_layer: CanvasLayer
var _hud_labels: Array[Label] = []
var _notification_label: Label
var _wind_label: Label
var _pip_viewport: SubViewport
var _pip_canopy_node: Node3D
var _pip_camera: Camera3D
var _main_canopy_node: Node3D

# -------------------------------------- GAME STATE -------------------------------------
var _game_state: GameState = GameState.FREEFALL
var _malfunction: MalfunctionType = MalfunctionType.GOOD
var _current_mission: MissionType = MissionType.TRAINING
var _mission_completed: bool = false
var _mission_objectives: Dictionary

# -------------------------------------- PHYSICS ----------------------------------------
var _velocity_vec: Vector3 = Vector3.ZERO
var _forward_speed: float = 0.0
var _turn_input: float = 0.0
var _descent_rate: float = 0.0
var _prev_descent_rate: float = 0.0
var _vario_mps: float = 0.0
var _current_altitude: float = 250.0
var _max_speed: float = 40.0   # kts
var _accel: float = 5.0
var _turn_force: float = 3.0

# -------------------------------------- CONTROL FLAGS ----------------------------------
var _left_arm_idx: int = -1
var _right_arm_idx: int = -1
var _left_arm_angle: float = 0.0
var _right_arm_angle: float = 0.0
var _last_frame_keys: Dictionary = {"Q":false, "E":false, "C":false, "X":false, "V":false, "F":false, "R":false}
var _cam_cycle_held: bool = false
var _hud_toggle_held: bool = false
var _hud_visible: bool = true
var _cam_angle_idx: int = 0

# -------------------------------------- FLIGHT DATA ------------------------------------
var _initial_heading: float = 0.0
var _turn_target_heading: float = 0.0
var _turn_rate: float = 45.0   # degrees per second
var _pattern_state: PatternState = PatternState.DOWNWIND
var LegLabel: String = "LEG"    # required string R064

# -------------------------------------- SCORING / LEADERBOARD --------------------------
var _score: int = 0
var _leaderboard: Array = []
var _achievements: Dictionary = {"FIRST_LANDING":false, "ACCURACY_10M":false, "EXPERT_MISSION":false}
var _flight_control_checked: bool = false
var _cutaway_done: bool = false
var _reserve_done: bool = false
var _flare_done: bool = false
var _safe_landing: bool = false
var _decision_altitude_warning_shown: bool = false
var _canopy_deployed: bool = false
var _deployment_timer: float = 0.0

# -------------------------------------- WIND ------------------------------------------
var _wind_base_speed: float = 10.0
var _wind_base_direction: float = 90.0
var _wind_turbulence: float = 2.0
var _wind_gust_time: float = 0.0
var _wind_current_gust: float = 0.0
var _sentry_initialized: bool = false

# -------------------------------------- REPLAY ----------------------------------------
var _replay_recording: Array = []
var _replay_playing: bool = false
var _replay_index: int = 0
var _frame_count: int = 0

