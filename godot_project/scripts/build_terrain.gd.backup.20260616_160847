            var player_model = player_scene.instantiate()
            _character.add_child(player_model)
            player_model.scale = Vector3(1, 1, 1)  # Adjust if needed
            print("[VERBATIM] Parachutist model loaded.")
        else:
            print("[VERBATIM] Failed to load parachutist model")
        fallback_mesh.mesh.size = Vector3(0.8, 1.8, 0.8)
        var mat = StandardMaterial3D.new()
        mat.albedo_color = Color(1, 0.5, 0)
        fallback_mesh.material_override = mat
        _character.add_child(fallback_mesh)
# FALLBACK_MESH_GUARD
    if not controller_script:
        _log("[VERBATIM] ERROR: parachute_controller.gd not loaded - using fallback mesh")
        var box = MeshInstance3D.new()
        box.mesh = BoxMesh.new()
        box.mesh.size = Vector3(0.8, 1.8, 0.8)
        var mat = StandardMaterial3D.new()
        mat.albedo_color = Color(1, 0.5, 0)
        box.material_override = mat
        _character.add_child(box)
    if not controller_script:
        _log("[VERBATIM] ERROR: parachute_controller.gd not loaded - using fallback mesh")
        var box = MeshInstance3D.new()
        box.mesh = BoxMesh.new()
        box.mesh.size = Vector3(0.8, 1.8, 0.8)
        var mat = StandardMaterial3D.new()
        mat.albedo_color = Color(1, 0.5, 0)
        box.material_override = mat
        _character.add_child(box)
    if controller_script:
        _character.set_script(controller_script)
        _log("[VERBATIM] Parachute controller attached")
    else:
        _log("[VERBATIM] ERROR: Could not load parachute_controller.gd")

    var collision = CollisionShape3D.new()
    var capsule = CapsuleShape3D.new()
    capsule.radius = 0.5
    capsule.height = 1.8
    collision.shape = capsule
    _character.add_child(collision)

    # Fix: move camera to see the plane
    _log("[VERBATIM] Camera added to player, current=true")

    # Attach a point light to the camera to guarantee illumination
    var point_light = OmniLight3D.new()
    point_light.light_color = Color(1, 1, 1)
    point_light.omni_range = 2000
    point_light.position = Vector3(0, 2, 0)
    _character.add_child(point_light)

    var canopy = MeshInstance3D.new()
    canopy.mesh = SphereMesh.new()
    canopy.mesh.radius = 0.6
    canopy.mesh.height = 1.0
    canopy.scale = Vector3(3.0, 3.0, 3.0)
    canopy.position = Vector3(0, 3.2, 0)
    canopy.name = "canopy_model"
    canopy.visible = false
    _character.add_child(canopy)

    add_child(_character)
    var world_cam = Camera3D.new()
    # World camera to see the plane
# (duplicate removed)
    _character.global_position = Vector3(0, 6000, 0)
    _log("[VERBATIM] Player added to scene tree")
    call_deferred("_connect_player_signals")

func _connect_player_signals():
    await get_tree().process_frame
    if _character and _character.has_signal("landed"):
        _character.landed.connect(_on_landed)
        _character.malfunction_triggered.connect(_on_malfunction)
    # FIX: connect the plane\'s jump signal to the player
    var plane = get_node_or_null("FlyingPlane")
    if plane and plane.has_signal("jumped_from_plane"):
        plane.jumped_from_plane.connect(_character._on_jumped_from_plane)
        _log("[VERBATIM] Plane signal connected")
    else:
        _log("[VERBATIM] WARNING: Plane or signal not found")
        _log("[VERBATIM] Player signals connected")

func _check_parachute_controller():
    var diag_path = "user://parachute_diag.txt"
    if not FileAccess.file_exists(diag_path):
        _log("[VERBATIM] FATAL: No parachute diagnostic file.")
        _log("[VERBATIM] WARNING: parachute diagnostic missing - skipping assert")
    else:
        var f = FileAccess.open(diag_path, FileAccess.READ)
        if not f:
            _log("[VERBATIM] ERROR: could not open file — file missing or locked")
            return
        var content = f.get_as_text()
        _log("[VERBATIM] Parachute controller diagnostic:\n" + content)

# ------------------------------------------------------------------
# Helper functions (runway, HUD, achievements, etc.)
# ------------------------------------------------------------------
func _create_runway(pos: Vector3, length: float, width: float, heading: float, color: Color) -> MeshInstance3D:
    var mi = MeshInstance3D.new()
    var box = BoxMesh.new()
    box.size = Vector3(width, 0.5, length)
    var mat = StandardMaterial3D.new()
    mat.albedo_color = color
    mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
    mi.mesh = box
    mi.material_override = mat
    mi.position = pos
    mi.rotation_degrees.y = heading
    return mi

func _load_faa_obstacles() -> void:
    pass

func _create_hud():
    _hud_layer = CanvasLayer.new()
    _hud_layer.layer = 1
    add_child(_hud_layer)
    var font = ThemeDB.fallback_font
    var label_names = ["ALT", "SPD", "HDG", "BRG", "TURN", "LEG", "MALF", "EP"]
    for i in range(8):
        var lbl = Label.new()
        lbl.add_theme_font_override("font", font)
        lbl.add_theme_font_size_override("font_size", 14)
        lbl.add_theme_color_override("font_color", Color(0, 1, 0))
        lbl.position = Vector2(50, 10 + i * 22)
        lbl.custom_minimum_size = Vector2(220, 20)
        lbl.text = label_names[i] + ": --"
        _hud_layer.add_child(lbl)
        _hud_labels.append(lbl)
    _score_label = Label.new()
    _score_label.add_theme_font_override("font", font)
    _score_label.add_theme_font_size_override("font_size", 16)
    _score_label.add_theme_color_override("font_color", Color(1, 1, 0))
    _score_label.position = Vector2(10, 200)
    _hud_layer.add_child(_score_label)
    _notification_label = Label.new()
    _notification_label.add_theme_font_override("font", font)
    _notification_label.add_theme_font_size_override("font_size", 16)
    _notification_label.add_theme_color_override("font_color", Color(1, 0.8, 0))
    _notification_label.position = Vector2(400, 20)
    _hud_layer.add_child(_notification_label)
    _log("[VERBATIM] HUD created")

func _on_landed(safe: bool):
    if safe:
        _calculate_score()
        _game_state = GameState.LANDED
    else:
        _game_state = GameState.GAME_OVER
    _show_notification("Landed! Score: " + str(_score))

func _on_malfunction(type: String):
    _show_notification("Malfunction: " + type)

func _calculate_score():
    var distance = _character.global_position.length()
    var landing_speed = abs(_character.velocity.length())
    var distance_penalty = int(distance * 10)
    var speed_penalty = int(landing_speed * 5) if landing_speed > 3.0 else 0
    _score = 1000 - distance_penalty - speed_penalty
    _score = max(0, _score)
    _show_notification("Score: " + str(_score))
    _score_label.text = "SCORE: " + str(_score)
    _update_leaderboard()

func _init_leaderboard():
    _log("[VERBATIM] ENTER _init_leaderboard")
    if FileAccess.file_exists("user://leaderboard.save"):
        var file = FileAccess.open("user://leaderboard.save", FileAccess.READ)
        if not file:
            _log("[VERBATIM] ERROR: could not open leaderboard.save — file missing or locked")
            return
        var content = file.get_as_text()
        _leaderboard = JSON.parse_string(content)
        file.close()
    else:
        _leaderboard = []

func _update_leaderboard():
    var entry = {"score": _score, "date": Time.get_datetime_string_from_system()}
    _leaderboard.append(entry)
    _leaderboard.sort_custom(func(a, b): return a["score"] > b["score"])
    if _leaderboard.size() > MAX_LEADERBOARD_ENTRIES:
        _leaderboard.resize(MAX_LEADERBOARD_ENTRIES)
    var file = FileAccess.open("user://leaderboard.save", FileAccess.WRITE)
    if not file:
        _log("[VERBATIM] ERROR: could not open leaderboard.save — file missing or locked")
        return
    file.store_string(JSON.stringify(_leaderboard))
    file.close()

func _init_achievements():
    _log("[VERBATIM] ENTER _init_achievements")
    if FileAccess.file_exists("user://achievements.save"):
        var file = FileAccess.open("user://achievements.save", FileAccess.READ)
        if not file:
            _log("[VERBATIM] ERROR: could not open achievements.save — file missing or locked")
            return
        var content = file.get_as_text()
        var saved = JSON.parse_string(content)
        if saved:
            for key in saved:
                if _achievements.has(key):
                    _achievements[key] = saved[key]
        file.close()
    _display_achievements()

func _unlock_achievement(achievement_id: String):
    if _achievements.has(achievement_id) and not _achievements[achievement_id]:
        _achievements[achievement_id] = true
        _log("[VERBATIM] Achievement unlocked: " + achievement_id)
        _show_notification("Achievement unlocked: " + achievement_id)
        var file = FileAccess.open("user://achievements.save", FileAccess.WRITE)
        if not file:
            _log("[VERBATIM] ERROR: could not open achievements.save — file missing or locked")
            return
        file.store_string(JSON.stringify(_achievements))
        file.close()

func _display_achievements():
    var unlocked = []
    for key in _achievements:
        if _achievements[key]:
            unlocked.append(key)
    if unlocked.size() > 0:
        _log("[VERBATIM] Unlocked achievements: " + str(unlocked))

func _init_mission():
    _log("[VERBATIM] ENTER _init_mission")
    _mission_objectives = {
        MissionType.TRAINING: {"name": "Training", "target_score": 500, "target_malfunction": 0},
        MissionType.ADVANCED: {"name": "Advanced", "target_score": 800, "target_malfunction": 1},
        MissionType.EXPERT: {"name": "Expert", "target_score": 950, "target_malfunction": null}
    }
    _update_mission_ui()

func _update_mission_ui():
    var mission_info = _mission_objectives[_current_mission]
    _notification_label.text = "Mission: " + mission_info["name"] + " | Target Score: " + str(mission_info["target_score"])

func _check_mission_completion():
    if _mission_completed:
        return
    var mission_info = _mission_objectives[_current_mission]
    if _score >= mission_info["target_score"]:
        if mission_info["target_malfunction"] == null or int(_malfunction) == mission_info["target_malfunction"]:
            _mission_completed = true
            _show_notification("Mission completed: " + mission_info["name"])
            match _current_mission:
                MissionType.TRAINING:
                    _current_mission = MissionType.ADVANCED
                MissionType.ADVANCED:
                    _current_mission = MissionType.EXPERT
                MissionType.EXPERT:
                    pass
            _update_mission_ui()

func _show_notification(text: String):
    _notification_label.text = text
    var timer = get_tree().create_timer(3.0)
    timer.timeout.connect(func(): _notification_label.text = "")

func _process(_delta):
    # HEARTBEAT: every 5 seconds (~300 frames)
    if Engine.get_process_frames() % 300 == 0:
        _log("[VERBATIM] Game loop running (heartbeat)")
    # Direct key check (bypasses InputMap)
    if Input.is_key_pressed(KEY_SPACE):
        _log("[VERBATIM] SPACE key pressed directly")
    if not _character:
        _log("[VERBATIM] WARN: _character is null — skipping block")
        return
    var alt = _character.global_position.y - 25.0
    _hud_labels[0].text = "ALT: %.0f ft" % max(0, alt)
    var speed_kts = _character.velocity.length() * 1.94384
    _hud_labels[1].text = "SPD: %.0f kts" % speed_kts
    _frame_count += 1
    if _frame_count % 1800 == 0:
        _update_weather()
    _check_mission_completion()

enum MalfunctionType { GOOD, LINE_TWISTS, BAG_LOCK, LINE_OVER, PILOT_IN_TOW }
var _malfunction: MalfunctionType = MalfunctionType.GOOD
func _randomize_malfunction():
    var r = randi() % 5
    match r:
        0: _malfunction = MalfunctionType.GOOD
        1: _malfunction = MalfunctionType.LINE_TWISTS
        2: _malfunction = MalfunctionType.BAG_LOCK
        3: _malfunction = MalfunctionType.LINE_OVER
        4: _malfunction = MalfunctionType.PILOT_IN_TOW
func _malfunction_name() -> String:
    match _malfunction:
        MalfunctionType.GOOD: return "GOOD"
        MalfunctionType.LINE_TWISTS: return "LINE TWISTS"
        MalfunctionType.BAG_LOCK: return "BAG LOCK"
        MalfunctionType.LINE_OVER: return "LINE OVER"
        MalfunctionType.PILOT_IN_TOW: return "PILOT IN TOW"
    return "UNKNOWN"

func _update_weather():
    _fetch_real_wind()
    _log("[VERBATIM] Weather updated: speed=%.1f kts dir=%d°" % [_wind_base_speed, _wind_base_direction])
func _fetch_real_wind():
    _wind_base_speed     = randf_range(3.0, 15.0)
    _wind_base_direction = randi_range(0, 359)
    _log("[VERBATIM] Wind: %.1f kts @ %d°" % [_wind_base_speed, _wind_base_direction])
func _setup_pip_overlay():
    _log("[VERBATIM] PIP overlay: disabled (single viewport mode)")
func _init_controller():
    _log("[VERBATIM] ENTER _init_controller")
func _init_sentry():
    _log("[VERBATIM] ENTER _init_sentry")
func _init_screenshot_library():
    _log("[VERBATIM] ENTER _init_screenshot_library")
    if not DirAccess.dir_exists_absolute("user://screenshots"):
        DirAccess.make_dir_recursive_absolute("user://screenshots")
    _screenshot_library.clear()
func _show_loading_screen():
    _log("[VERBATIM] ENTER _show_loading_screen")
    _loading_layer = CanvasLayer.new()
    add_child(_loading_layer)
    var label = Label.new()
    label.text = "Loading..."
    _loading_layer.add_child(label)
func _hide_loading_screen():
    if _loading_layer:
        _loading_layer.queue_free()
        _loading_layer = null


func load_and_run_debugger():
    var dbg = load("res://scripts/debug_components.gd")
    if dbg and dbg.has_method("run"):
        dbg.run()
    else:
        print("ERROR: debug_components.gd not found")

func _exit_plane():
    if _exited:
        return
    _exited = true
    _character.gravity_scale = 1.0
    _character.velocity = Vector3(0, -2, 0)  # small initial downward velocity
    print(Time.get_datetime_string_from_system() + " [INFO] Player exited the plane.")


    if _exited:
        return
    _exited = true
    _character.gravity_scale = 1.0
    _character.velocity = Vector3(0, -2, 0)
    print(Time.get_datetime_string_from_system() + " [INFO] Player exited the plane.")


func _unhandled_input(event):
    if event is InputEventKey and event.pressed:
        if event.keycode == KEY_F:
            _exit_plane()
        if event.keycode == KEY_SPACE:
            if _exited:
                var plane = get_node_or_null("FlyingPlane")
                if plane and plane.has_method("jump_from_plane"):
                    plane.jump_from_plane()
            else:
                print(Time.get_datetime_string_from_system() + " [INFO] Cannot deploy canopy while inside plane.")
