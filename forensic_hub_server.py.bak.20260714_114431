#!/usr/bin/env python3
# forensic_hub_server.py -- stdlib-only HTTP server for the forensic HUD.
#
# Serves exactly the four endpoints forensic_hud.gd polls:
#   /api/gamification  -> level, xp, streak, success_rate, pokedex_*,
#                         unresolved_parse_errors, achievements
#   /api/leaderboard   -> [{name, error_class, wins, trials, win_rate, ucb1}]
#   /api/citations     -> {principles: [...], godot_docs: [...]}
#   /api/integrity     -> {quick_check}
#
# Data source: parachute_mutations.db opened READ-ONLY via
# file:PATH?mode=ro URI -- this server can never mutate the DB.
# Schema is introspected at runtime with PRAGMA table_info; nothing
# is assumed. Missing tables degrade to db_unavailable=true, which
# forensic_hud.gd already handles ("hub OK, DB unavailable").
#
# Run: python3 forensic_hub_server.py 2>&1 | tee hub_server.log

import json
import math
import sqlite3
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

PORT = 8765

# Candidate DB locations, largest existing file wins.
DB_CANDIDATES = [
    Path("parachute_mutations.db"),
    Path("godot_project/scripts/parachute_mutations.db"),
]


def find_db():
    existing = [p for p in DB_CANDIDATES if p.exists()]
    if not existing:
        return None
    return max(existing, key=lambda p: p.stat().st_size)


def db_connect_ro(path):
    # mode=ro: read-only URI -- server can never write the DB
    uri = "file:%s?mode=ro" % path
    return sqlite3.connect(uri, uri=True)


def table_columns(conn, table):
    try:
        rows = conn.execute("PRAGMA table_info(%s)" % table).fetchall()
        return [r[1] for r in rows]
    except sqlite3.Error:
        return []


def has_table(conn, table):
    row = conn.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name=?",
        (table,),
    ).fetchone()
    return row is not None


def pick(cols, *names):
    # Return the first column name present, or None.
    for n in names:
        if n in cols:
            return n
    return None


def api_gamification(conn):
    out = {}
    if not has_table(conn, "auto_heal_actions"):
        return {"db_unavailable": True}
    cols = table_columns(conn, "auto_heal_actions")
    success_col = pick(cols, "success", "succeeded", "ok")
    total = conn.execute("SELECT COUNT(*) FROM auto_heal_actions").fetchone()[0]
    out["xp"] = total
    out["level"] = 1 + total // 5000
    if success_col:
        wins = conn.execute(
            "SELECT COUNT(*) FROM auto_heal_actions WHERE %s=1" % success_col
        ).fetchone()[0]
        out["success_rate"] = round(wins / total, 4) if total else 0.0
        # streak: longest run of consecutive successes by id order
        streak = best = 0
        for (s,) in conn.execute(
            "SELECT %s FROM auto_heal_actions ORDER BY rowid" % success_col
        ):
            streak = streak + 1 if s == 1 else 0
            best = max(best, streak)
        out["streak"] = best
    if has_table(conn, "parse_error_log"):
        pcols = table_columns(conn, "parse_error_log")
        res_col = pick(pcols, "resolved", "fixed", "closed")
        total_pe = conn.execute("SELECT COUNT(*) FROM parse_error_log").fetchone()[0]
        if res_col:
            unresolved = conn.execute(
                "SELECT COUNT(*) FROM parse_error_log WHERE %s=0" % res_col
            ).fetchone()[0]
            out["unresolved_parse_errors"] = unresolved
            out["pokedex_caught"] = total_pe - unresolved
        out["pokedex_known"] = total_pe
    achievements = []
    if out.get("xp", 0) > 0:
        achievements.append("first_heal")
    if out.get("success_rate", 0) >= 0.35:
        achievements.append("healer_35pct")
    if out.get("streak", 0) >= 50:
        achievements.append("streak_50")
    out["achievements"] = achievements
    return out


def api_leaderboard(conn):
    if not has_table(conn, "strategy_rewards"):
        return []
    cols = table_columns(conn, "strategy_rewards")
    name_col = pick(cols, "strategy", "name", "strategy_name")
    class_col = pick(cols, "error_class", "class", "category")
    wins_col = pick(cols, "wins")
    trials_col = pick(cols, "trials", "attempts")
    if not (name_col and wins_col and trials_col):
        return []
    sel_class = class_col if class_col else "''"
    rows = conn.execute(
        "SELECT %s, %s, %s, %s FROM strategy_rewards"
        % (name_col, sel_class, wins_col, trials_col)
    ).fetchall()
    total_trials = sum(r[3] for r in rows) or 1
    board = []
    for name, eclass, wins, trials in rows:
        wr = round(wins / trials, 4) if trials else 0.0
        # UCB1: mean + sqrt(2 ln N / n)
        ucb1 = round(
            wr + math.sqrt(2.0 * math.log(max(total_trials, 2)) / max(trials, 1)), 4
        )
        board.append(
            {
                "name": name,
                "error_class": eclass or "",
                "wins": wins,
                "trials": trials,
                "win_rate": wr,
                "ucb1": ucb1,
            }
        )
    board.sort(key=lambda r: r["ucb1"], reverse=True)
    return board


