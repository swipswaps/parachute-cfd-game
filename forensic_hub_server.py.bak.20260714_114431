def api_integrity(conn):
    row = conn.execute("PRAGMA quick_check").fetchone()
    return {"quick_check": row[0] if row else "unknown"}


class Handler(BaseHTTPRequestHandler):
    def _send_json(self, obj, code=200):
        body = json.dumps(obj).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        db_path = find_db()
        try:
            if self.path == "/api/citations":
                self._send_json(api_citations())
                return
            if db_path is None:
                self._send_json({"db_unavailable": True})
                return
            conn = db_connect_ro(db_path)
            try:
                if self.path == "/api/gamification":
                    self._send_json(api_gamification(conn))
                elif self.path == "/api/leaderboard":
                    self._send_json(api_leaderboard(conn))
                elif self.path == "/api/integrity":
                    self._send_json(api_integrity(conn))
                else:
                    self._send_json({"error": "unknown endpoint", "path": self.path}, 404)
            finally:
                conn.close()
        except Exception as exc:
            self._send_json({"error": str(exc)}, 500)

    def log_message(self, fmt, *args):
        # Verbatim request logging to stdout -- never suppressed
        sys.stdout.write("%s - %s\n" % (self.address_string(), fmt % args))
        sys.stdout.flush()


def main():
    db_path = find_db()
    print("[HUB] DB: %s" % (db_path if db_path else "NOT FOUND (degraded mode)"))
    if db_path:
        print("[HUB] DB size: %d bytes" % db_path.stat().st_size)
    try:
        server = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    except OSError as exc:
        print("[HUB] FAILED to bind 127.0.0.1:%d -- %s" % (PORT, exc))
        print("[HUB] Another hub instance may already be running.")
        sys.exit(1)
    print("[HUB] Serving on http://127.0.0.1:%d" % PORT)
    print("[HUB] Endpoints: /api/gamification /api/leaderboard /api/citations /api/integrity")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("[HUB] Stopped.")


if __name__ == "__main__":
    main()
