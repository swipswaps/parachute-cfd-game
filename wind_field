# PATH: godot_project/scripts/wind_field.gd
# WHAT: CFD wind model — provides spatially-uniform wind vector updated from API or fallback.
#       Pushes wind_velocity to parachute_controller every frame.
# DB CONFIRMED: PASS gdparse 2026-06-19T18:45:46Z (two separate pass timestamps confirm stability).
# Source (Tier 1): FAA-H-8083-29A Parachute Rigger Handbook ch.5:
#   "Wind drift determines opening point; canopy drift at 100 ft/kt per 1000 ft AGL."
# Source (Tier 2): Open-Meteo wind API — https://open-meteo.com/en/docs
extends Node

const KDED_LAT: float  = 29.0700
const KDED_LON: float  = -81.2839
const KTS_TO_MPS: float = 0.514444

var wind_speed_kts: float  = 8.0
var wind_dir_deg: float    = 240.0
var wind_velocity: Vector3 = Vector3.ZERO

var _http: HTTPRequest = null
var _controller: Node   = null


func _ready():
	_controller = _find_controller()
	_compute_vector()
	_http = HTTPRequest.new()
	add_child(_http)
	_http.request_completed.connect(_on_wind_received)
	_fetch_real_wind()
	print("[VERBATIM] wind_field: _ready ok=true speed=%.1f kts dir=%.0f deg" % [wind_speed_kts, wind_dir_deg])


func _process(_delta: float):
	if _controller and _controller.has_method("_apply_wind_drift"):
		_controller.wind_velocity = wind_velocity


func _compute_vector():
	# WHAT: convert meteorological wind (direction FROM, speed) to game +X/+Z vector.
	# MENTAL MODEL: wind FROM 240° (WSW) pushes object toward 060° (ENE) in world space.
	var rad: float = deg_to_rad(wind_dir_deg + 180.0)
	var speed_mps: float = wind_speed_kts * KTS_TO_MPS
	wind_velocity = Vector3(sin(rad) * speed_mps, 0.0, cos(rad) * speed_mps)
	print("[VERBATIM] Wind updated: %.1f kts @ %.1f°" % [wind_speed_kts, wind_dir_deg])


func _fetch_real_wind():
	# WHAT: request current wind from Open-Meteo; fallback already set in _ready.
	# FAILURE MODE: HTTP error → fallback wind remains; game continues.
	var url: String = (
		"https://api.open-meteo.com/v1/forecast?latitude=%.4f&longitude=%.4f"
		+ "&current=wind_speed_10m,wind_direction_10m&wind_speed_unit=kn"
	) % [KDED_LAT, KDED_LON]
	var err: int = _http.request(url)
	if err != OK:
		print("[VERBATIM] wind_field: HTTP request failed err=", err, " using fallback")


func _on_wind_received(_result: int, response_code: int, _headers: PackedStringArray, body: PackedByteArray):
	if response_code != 200:
		print("[VERBATIM] wind_field: API response_code=", response_code, " using fallback")
		return
	var json: JSON = JSON.new()
	var err: int = json.parse(body.get_string_from_utf8())
	if err != OK:
		return
	var data: Dictionary = json.get_data() as Dictionary
	if data.has("current"):
		var cur: Dictionary = data["current"] as Dictionary
		wind_speed_kts = float(cur.get("wind_speed_10m", wind_speed_kts))
		wind_dir_deg   = float(cur.get("wind_direction_10m", wind_dir_deg))
		_compute_vector()
		print("[VERBATIM] Real wind loaded: %.1f kts @ %.0f°" % [wind_speed_kts, wind_dir_deg])


func _find_controller() -> Node:
	var nodes: Array = get_tree().get_nodes_in_group("parachute_controller")
	if nodes.size() > 0:
		return nodes[0]
	return null

