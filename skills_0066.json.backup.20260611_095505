      "code": "#!/usr/bin/env python3\nimport json, os, subprocess, shutil, sys\nfrom datetime import datetime\n\ndef backup_file(filepath):\n    ts = datetime.now().strftime('%Y%m%d_%H%M%S')\n    backup = f'{filepath}.backup.{ts}'\n    shutil.copy2(filepath, backup)\n    print(f'✅ Backup: {backup}')\n    return backup\n\ndef read_json(filepath):\n    with open(filepath, 'r') as f:\n        return json.load(f)\n\ndef write_json(data, filepath):\n    with open(filepath, 'w') as f:\n        json.dump(data, f, indent=2)\n    print(f'✅ Written to {filepath}')\n\ndef get_next_version(current):\n    num = int(current[1:])\n    return f'v{num+1:04d}'\n\ndef add_library(data, lib_def):\n    if 'best_practice_libraries' not in data:\n        data['best_practice_libraries'] = []\n    data['best_practice_libraries'].append(lib_def)\n    print(f'✅ Added: {lib_def[\"name\"]}')\n\ndef update_version_and_history(data, new_ver, desc):\n    old = data['version']\n    data['version'] = new_ver\n    data['version_history'][new_ver] = desc\n    data['what_was_learned'] += f' {new_ver} adds {desc}.'\n    print(f'✅ Version {old} → {new_ver}')\n\ndef validate_json(filepath):\n    result = subprocess.run(['python3', '-m', 'json.tool', filepath],\n                            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)\n    if result.returncode == 0:\n        print('✅ JSON valid')\n        return True\n    print(f'❌ {result.stderr.decode()}')\n    return False\n\ndef run_audit(filepath):\n    if not os.path.exists('skills_audit.py'):\n        print('⚠️ No audit – skipping')\n        return True\n    result = subprocess.run(['python3', 'skills_audit.py', filepath],\n                            capture_output=True, text=True)\n    print(result.stdout)\n    if 'FAIL: 0' in result.stdout:\n        print('✅ Audit passed')\n        return True\n    print('❌ Audit failed')\n    return False\n\ndef main():\n    if len(sys.argv) != 3:\n        print('Usage: python3 add_library.py <skills.json>