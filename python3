def get_existing_columns(conn, table_name):
    cur = conn.cursor()
    cur.execute(f"PRAGMA table_info({table_name})")
    return {row[1] for row in cur.fetchall()}

def ensure_schema(conn):
    cur = conn.cursor()
    for table in ["known_repairs", "strategy_rewards"]:
        cur.execute(f"DROP TABLE IF EXISTS {table}")
        cols = EXPECTED_TABLES[table]
        col_defs = []
        for col_name, col_type in cols:
            if col_name.upper().startswith("UNIQUE"):
                col_defs.append(col_name)
            else:
                col_defs.append(f"{col_name} {col_type}")
        cur.execute(f"CREATE TABLE {table} ({', '.join(col_defs)})")
        print(f"[SCHEMA] Recreated {table}.", flush=True)
    conn.commit()

    for table_name, columns in EXPECTED_TABLES.items():
        if table_name in ("known_repairs", "strategy_rewards"):
            continue
        col_defs = []
        for col_name, col_type in columns:
            if col_name.upper().startswith("UNIQUE"):
                continue
            col_defs.append(f"{col_name} {col_type}")
        try:
            cur.execute(f"CREATE TABLE IF NOT EXISTS {table_name} ({', '.join(col_defs)})")
        except sqlite3.OperationalError as e:
            print(f"[SCHEMA] Note creating {table_name}: {e}", flush=True)
        existing = get_existing_columns(conn, table_name)
        for col_name, col_type in columns:
            if col_name.upper().startswith("UNIQUE") or col_name in existing:
                continue
            safe_type = col_type
            if "NOT NULL" in safe_type.upper() and "DEFAULT" not in safe_type.upper():
                safe_type += " DEFAULT 0" if "INTEGER" in safe_type.upper() else " DEFAULT ''"
            safe_type = re.sub(r"NOT\s+NULL", "", safe_type, flags=re.IGNORECASE)
            try:
                cur.execute(f"ALTER TABLE {table_name} ADD COLUMN {col_name} {safe_type}")
            except sqlite3.OperationalError as e:
                if "duplicate column name" not in str(e):
                    raise
    conn.commit()

    for cls, pattern, desc in FINGERPRINTS:
        cur.execute(
            "INSERT OR IGNORE INTO error_fingerprints (error_class, pattern, description) VALUES (?,?,?)",
            (cls, pattern, desc)
        )
