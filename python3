def _add_user_bin_to_path():
    user_base = subprocess.run(
        [sys.executable, "-m", "site", "--user-base"],
        capture_output=True, text=True
    ).stdout.strip()
    if user_base:
        user_bin = os.path.join(user_base, "bin")
        if os.path.isdir(user_bin) and user_bin not in os.environ.get("PATH", ""):
            os.environ["PATH"] = user_bin + os.pathsep + os.environ.get("PATH", "")
    home = os.path.expanduser("~")
    for d in [os.path.join(home, ".local", "bin"), os.path.join(home, ".bin")]:
        if os.path.isdir(d) and d not in os.environ.get("PATH", ""):
            os.environ["PATH"] = d + os.pathsep + os.environ.get("PATH", "")

def tool_installed(name):
    return shutil.which(name) is not None

def install_tool(name, package):
    if name == "gdstyle":
        if not tool_installed("cargo"):
            print(f"[DEPENDENCY] cargo missing; cannot install gdstyle. Skipping.", flush=True)
            return False
        result = subprocess.run(["cargo", "install", "gdstyle"], capture_output=True, text=True)
        return result.returncode == 0
    result = subprocess.run(
        [sys.executable, "-m", "pip", "install", "--user", "--upgrade", package],
        capture_output=True, text=True
    )
    if result.returncode == 0:
        _add_user_bin_to_path()
        return True
    return False

def ensure_dependencies():
    _add_user_bin_to_path()
    print("[DEPENDENCY] Checking required tools...", flush=True)
    for tool, pkg in REQUIRED_TOOLS.items():
        if not tool_installed(tool):
            print(f"[DEPENDENCY] {tool} missing. Attempting install via {pkg}...", flush=True)
            if install_tool(tool, pkg):
                print(f"[DEPENDENCY] {tool} installed successfully.", flush=True)
            else:
                print(f"[DEPENDENCY] Could not install {tool}. Continuing (may fail later).", flush=True)
        else:
            print(f"[DEPENDENCY] {tool} found.", flush=True)
    if not tool_installed("gdparse"):
        print("[DEPENDENCY] CRITICAL: gdparse is missing. Cannot continue.", flush=True)
        return False
    return True

