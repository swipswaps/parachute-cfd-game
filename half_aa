Plane Fix

You're right — the pipeline is stalling without displaying logs because the ts and tee pipeline is buffering output. We need to run it with unbuffered output so we can see what's happening in real-time.

Let me create a script that:

    Runs the pipeline with unbuffered output so we can see logs in real-time

    Kills the stalled process and restarts it properly

    Captures complete logs for analysis

python

#!/usr/bin/env python3
"""
run_pipeline_unbuffered.py - Run pipeline with real-time log output
"""

import os
import sys
import subprocess
import signal
import time
from pathlib import Path

PROJECT_ROOT = "/home/owner/Documents/69f7bcc6-1f68-83ea-b9b2-95a4db8629ac/parachute-cfd-game"
LOG_FILE = os.path.join(PROJECT_ROOT, "pipeline_run_with_full_guardrails.log")

def kill_stalled_pipeline():
    """Kill any stalled pipeline processes."""
    print("Checking for stalled pipeline processes...")
    
    # Find python processes running the pipeline
    cmd = "ps aux | grep 'run_pipeline_v6_5_207' | grep -v grep"
    result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
    
    if result.stdout:
        print(f"Found running pipeline processes:\n{result.stdout}")
        
        # Kill them
        cmd = "pkill -f 'run_pipeline_v6_5_207'"
        subprocess.run(cmd, shell=True)
        time.sleep(1)
        print("Killed stalled processes")
    else:
        print("No stalled pipeline processes found")

def run_pipeline_unbuffered():
    """Run pipeline with unbuffered output."""
    print("\n" + "=" * 60)
    print("RUNNING PIPELINE WITH UNBUFFERED OUTPUT")
    print("=" * 60)
    
    # First, kill any stalled processes
    kill_stalled_pipeline()
    
    # Clear the log file
    if os.path.exists(LOG_FILE):
        os.remove(LOG_FILE)
    
    # Use python -u for unbuffered output
    # Use stdbuf for tee to avoid buffering
    cmd = f"""
    cd {PROJECT_ROOT} && \
    sudo HEADLESS=0 python3 -u run_pipeline_v6_5_207.py 2>&1 | \
    stdbuf -oL -eL ts | \
    stdbuf -oL -eL tee {LOG_FILE}
    """
    
    print(f"Command: {cmd}")
    print("\n" + "-" * 60)
    print("REAL-TIME OUTPUT (press Ctrl+C to stop, logs are still being saved)")
    print("-" * 60 + "\n")
    
    try:
        # Run with real-time output
        process = subprocess.Popen(
            cmd,
            shell=True,
            executable='/bin/bash',
            stdout=None,  # Use parent's stdout
            stderr=None,  # Use parent's stderr
            bufsize=0,    # Unbuffered
        )
        
        # Wait for the process
        process.wait()
        
        print("\n" + "-" * 60)
        print(f"Pipeline completed with return code: {process.returncode}")
        print("-" * 60)
        
        return process.returncode
        
    except KeyboardInterrupt:
        print("\n\nPipeline interrupted by user")
        print("Killing process...")
        process.terminate()
        time.sleep(1)
        process.kill()
        return 130
    except Exception as e:
        print(f"\nError running pipeline: {e}")
        return 1

def check_results():
    """Check the results from the log file."""
    if not os.path.exists(LOG_FILE):
        print(f"Log file not found: {LOG_FILE}")
        return
    
    print("\n" + "=" * 60)
    print("CHECKING RESULTS")
    print("=" * 60)
    
    with open(LOG_FILE, 'r') as f:
        content = f.read()
    
    # Key checks
    checks = {
        "Cessna model loaded": "Cessna model loaded" in content,
        "Plane created": "Plane created: True" in content or "Plane node created" in content,
        "Camera attached": "Camera attached: True" in content or "camera.look_at" in content,
        "Pipeline passed": "outcome=FAIL" not in content,
        "Self-heal complete": "HEAL-OK" in content,
        "Plane script attached": "Plane script attached" in content,
        "Test runner found plane": "Plane created: True" in content,
    }
    
    for name, result in checks.items():
        status = "✓" if result else "✗"
        print(f"  {status} {name}: {result}")
    
    # Count errors
    error_count = content.count("ERROR:")
    script_error_count = content.count("SCRIPT ERROR")
    parse_error_count = content.count("Parse Error")
    
    print(f"\n  Error count: {error_count}")
    print(f"  Script errors: {script_error_count}")
    print(f"  Parse errors: {parse_error_count}")
    
    # Check if we have test results
    if "TEST] Plane created:" in content:
        # Extract test results
        import re
        plane_match = re.search(r'\[TEST\] Plane created: (\w+)', content)
        camera_match = re.search(r'\[TEST\] Camera attached: (\w+)', content)
        
        if plane_match:
            print(f"  Plane created: {plane_match.group(1)}")
        if camera_match:
            print(f"  Camera attached: {camera_match.group(1)}")
    
    # Show last 20 lines
    print("\n" + "-" * 60)
    print("LAST 20 LINES OF LOG:")
    print("-" * 60)
    
    lines = content.split('\n')
    for line in lines[-20:]:
        if line.strip():
            print(line[:120])  # Truncate long lines

def main():
    # Run pipeline with unbuffered output
    return_code = run_pipeline_unbuffered()
    
    # Check results
    check_results()
    
    print("\n" + "=" * 60)
    print("DONE")
    print(f"Log saved to: {LOG_FILE}")
    print("=" * 60)
    
    sys.exit(return_code)

if __name__ == "__main__":
    main()

