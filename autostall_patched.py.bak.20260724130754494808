def make_timestamped_backup(p) -> object:
    ts = datetime.now().strftime("%Y%m%d%H%M%S%f")
    backup_path = p.with_suffix(p.suffix + f".bak.{ts}")
    shutil.copy2(p, backup_path)
    return backup_path

def apply_auto_start_patch() -> Tuple[bool, str]:
    file_path = os.path.join(PROJECT_DIR, "scripts", "build_terrain.gd")
    p = Path(file_path)
    if not p.exists():
        return False, f"File not found: {file_path}"
    with open(p, 'r') as f:
        lines = f.readlines()

    for line in lines:
        if "# Headless auto‑start: simulate SPACE press" in line:
            return True, "Auto‑start patch already applied."

    ready_line_idx = None
    for i, line in enumerate(lines):
        if "Game ready – press SPACE at ~4000 ft to deploy" in line:
            ready_line_idx = i
            break
    if ready_line_idx is None:
        return False, "Could not locate 'Game ready' message line."

    indent = re.match(r'^[ \t]*', lines[ready_line_idx]).group(0)
    backup_path = make_timestamped_backup(p)

    auto_start_block = [
        f"{indent}# Headless auto‑start: simulate SPACE press\n",
        f"{indent}if OS.get_environment(\"GODOT_HEADLESS\") == \"1\":\n",
        f"{indent}\tInput.action_press(\"ui_accept\")\n",
        f"{indent}\tInput.action_release(\"ui_accept\")\n",
        f"{indent}\tprint(\"[VERBATIM] Headless auto‑start triggered.\")\n",
    ]
    lines[ready_line_idx+1:ready_line_idx+1] = auto_start_block

    with open(p, 'w') as f:
        f.writelines(lines)

    return True, f"Auto‑start patch applied. Backup at {backup_path}"

def patch_hub_manager() -> Tuple[bool, str]:
    """Add environment check to HubManager.gd so it skips startup when hub is already running."""
    hub_manager_path = None
    for path in [
        os.path.join(PROJECT_DIR, "scripts", "HubManager.gd"),
        os.path.join(PROJECT_DIR, "autoloads", "HubManager.gd"),
    ]:
        if os.path.isfile(path):
            hub_manager_path = path
            break
    if not hub_manager_path:
        return False, "HubManager.gd not found – skipping patch"

    with open(hub_manager_path, 'r') as f:
        lines = f.readlines()

    # Check if already patched
    for line in lines:
        if "GODOT_HUB_ALREADY_RUNNING" in line:
            return True, "HubManager.gd already patched"

    # Find the line that says "Hub not responding; starting it..."
    start_idx = None
    for i, line in enumerate(lines):
        if "Hub not responding; starting it..." in line:
            start_idx = i
            break
    if start_idx is None:
        return False, "Could not locate startup line in HubManager.gd"

    indent = re.match(r'^[ \t]*', lines[start_idx]).group(0)

    # Insert check block before the startup line
    check_block = [
        f'{indent}# Added by autostall_patched.py – skip if hub already running\n',
        f'{indent}if OS.get_environment("GODOT_HUB_ALREADY_RUNNING") == "1":\n',
        f'{indent}\tprint("[HubManager] Hub already running – skipping startup")\n',
        f'{indent}\treturn\n',
        f'{indent}# Original startup block follows\n',
    ]
    lines[start_idx:start_idx] = check_block

    backup_path = make_timestamped_backup(Path(hub_manager_path))
    with open(hub_manager_path, 'w') as f:
        f.writelines(lines)

    return True, f"HubManager.gd patched. Backup at {backup_path}"

# ------------------------------------------------------------------
# PATCH: SqliteDb.gd – add busy_timeout and WAL (FIXED indentation)
# ------------------------------------------------------------------
def patch_sqlite_db(db_conn) -> Tuple[bool, str]:
    """Insert PRAGMA busy_timeout and journal_mode=WAL after the open_db check."""
    gd_path = os.path.join(PROJECT_DIR, "scripts", "SqliteDb.gd")
    if not os.path.isfile(gd_path):
        log_event(db_conn, "patch_sqlite_db", "error", f"File not found: {gd_path}")
        return False, f"File not found: {gd_path}"

    with open(gd_path, "r", encoding="utf-8") as f:
        lines = f.readlines()

    # Locate the 'if not _db.open_db():' line
    open_if_idx = None
    for i, line in enumerate(lines):
        if re.search(r'if\s+not\s+_db\.open_db\s*\(', line):
            open_if_idx = i
            break

    if open_if_idx is None:
        log_event(db_conn, "patch_sqlite_db", "error", "Could not find 'if not _db.open_db():'")
        return False, "open_db check not found"

    # Find the end of the if block: look for the next line with indentation <= the if line.
    if_indent = re.match(r'^[ \t]*', lines[open_if_idx]).group(0)
    block_end_idx = open_if_idx + 1
    while block_end_idx < len(lines):
        cur = lines[block_end_idx]
        if cur.strip() == "":
            block_end_idx += 1
            continue
        cur_indent = re.match(r'^[ \t]*', cur).group(0)
        # If the line is not indented more than the if, it's outside the block.
        if len(cur_indent) <= len(if_indent):
            break
        block_end_idx += 1

    # Insert after the block (i.e., at block_end_idx)
    # Prepare PRAGMA lines with the same indentation as the if line.
    pragma_lines = [
        f'{if_indent}_db.query("PRAGMA busy_timeout = 5000;")\n',
        f'{if_indent}_db.query("PRAGMA journal_mode = WAL;")\n',
    ]
    new_lines = lines[:block_end_idx] + pragma_lines + lines[block_end_idx:]

    new_content = "".join(new_lines)
    backup_path = make_timestamped_backup(Path(gd_path))
    with open(gd_path, "w", encoding="utf-8") as f:
        f.write(new_content)

    # Read‑after‑write
    with open(gd_path, "r", encoding="utf-8") as f:
        written = f.read()
    if written != new_content:
        log_event(db_conn, "patch_sqlite_db", "error", "Read‑back mismatch")
        return False, "Read‑back mismatch after writing SqliteDb.gd"

    log_event(db_conn, "patch_sqlite_db", "success", "Added busy_timeout and WAL PRAGMAs (after open_db check)")
    return True, f"SqliteDb.gd patched. Backup at {backup_path}"

# ------------------------------------------------------------------
# PATCH: forensic_hud.gd – add drag variables, mouse_filter
# ------------------------------------------------------------------
def patch_forensic_hud(db_conn) -> Tuple[bool, str]:
    gd_path = os.path.join(PROJECT_DIR, "scripts", "forensic_hud.gd")
    if not os.path.isfile(gd_path):
        log_event(db_conn, "patch_forensic_hud", "error", f"File not found: {gd_path}")
        return False, f"File not found: {gd_path}"

    with open(gd_path, "r", encoding="utf-8") as f:
        content = f.read()

    # Check if drag variables exist
    has_dragging = "var dragging" in content
    has_offset = "var drag_offset" in content
    if not has_dragging or not has_offset:
        lines = content.split("\n")
        insert_idx = 0
        for i, line in enumerate(lines):
            if re.match(r'^(class|extends|tool)\s+', line):
                insert_idx = i + 1
                break
        new_lines = lines[:insert_idx]
        if not has_dragging:
            new_lines.append("var dragging: bool = false")
        if not has_offset:
            new_lines.append("var drag_offset: Vector2 = Vector2.ZERO")
        new_lines.append("")
        new_lines.extend(lines[insert_idx:])
        content = "\n".join(new_lines)

    # Check if mouse_filter is set in _ready
    if "mouse_filter" not in content:
        lines = content.split("\n")
        ready_idx = None
        for i, line in enumerate(lines):
            if re.search(r'^func\s+_ready\s*\(', line):
                ready_idx = i
                break
        if ready_idx is None:
            log_event(db_conn, "patch_forensic_hud", "error", "_ready not found")
            return False, "_ready function not found"
        indent = re.match(r'^[ \t]*', lines[ready_idx]).group(0)
        lines.insert(ready_idx+1, f"{indent}mouse_filter = MOUSE_FILTER_STOP\n")
        content = "\n".join(lines)

    if "_gui_input" not in content:
        log_event(db_conn, "patch_forensic_hud", "error", "_gui_input missing")
        return False, "_gui_input method not found"

    backup_path = make_timestamped_backup(Path(gd_path))
    with open(gd_path, "w", encoding="utf-8") as f:
        f.write(content)

    with open(gd_path, "r", encoding="utf-8") as f:
        written = f.read()
    if written != content:
        log_event(db_conn, "patch_forensic_hud", "error", "Read‑back mismatch")
        return False, "Read‑back mismatch"

    log_event(db_conn, "patch_forensic_hud", "success", "Added drag variables and mouse_filter")
    return True, f"forensic_hud.gd patched. Backup at {backup_path}"

