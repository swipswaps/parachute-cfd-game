# ------------------------------------------------------------------
# Hub health check (streaming, Rule #32)
# ------------------------------------------------------------------
def hub_is_healthy(port=HUB_PORT):
    cmd = [
        "curl", "-s", "-o", "/dev/null", "-w", "%{http_code}",
        "--connect-timeout", "2", "--max-time", "3",
        f"http://127.0.0.1:{port}/api/gamification"
    ]
    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1
        )
        out, err = proc.communicate(timeout=5)
        return proc.returncode == 0 and out.strip() == "200"
    except Exception:
        return False

def ensure_hub_healthy(db_conn):
    print("[HUB] Checking hub health...")
    if hub_is_healthy():
        print("[HUB] Hub is already healthy.")
        log_event(db_conn, "hub_preflight", "success", "Hub healthy before launch")
        os.environ["GODOT_HUB_ALREADY_RUNNING"] = "1"
        return True

    print("[HUB] Hub not responding. Attempting to start it...")
    if os.path.isfile(HUB_GUARDIAN):
        try:
            subprocess.run([sys.executable, HUB_GUARDIAN], check=True, timeout=30)
            if hub_is_healthy():
                print("[HUB] Hub started successfully via guardian.")
                log_event(db_conn, "hub_preflight", "success", "Hub started via hub_guardian.py")
                os.environ["GODOT_HUB_ALREADY_RUNNING"] = "1"
                return True
            else:
                print("[HUB] Guardian started but hub not healthy.")
                log_event(db_conn, "hub_preflight", "error", "Guardian failed to start hub")
        except Exception as e:
            print(f"[HUB] Guardian failed: {e}")
            log_event(db_conn, "hub_preflight", "error", f"Guardian exception: {e}")
    else:
        print("[HUB] Starting hub directly (fallback).")
        with open("/tmp/hub_server.log", 'a') as logfile:
            proc = subprocess.Popen(
                [sys.executable, HUB_SCRIPT],
                stdout=logfile,
                stderr=logfile,
                stdin=subprocess.DEVNULL,
                start_new_session=True
            )
        time.sleep(2)
        if hub_is_healthy():
            print("[HUB] Hub started directly.")
            log_event(db_conn, "hub_preflight", "success", "Hub started directly")
            os.environ["GODOT_HUB_ALREADY_RUNNING"] = "1"
            return True
        else:
            print("[HUB] Direct start failed.")
            log_event(db_conn, "hub_preflight", "error", "Direct start failed")
    print("[HUB] WARNING: Proceeding without hub – Godot may stall.")
    return False

# ------------------------------------------------------------------
# Logging helper (FIXED: handles NOT NULL file_path)
